+// A job queued by resume before manifests existed has delivered skills and no manifest. The
+// launch-time check must refuse it even though admission already passed.
+func TestResumeQueuedLegacySkillsRefusedAtLaunch(t *testing.T) {
+	m, _ := skillsManager(t)
+	j := enqueue(t, m, "resume guard", func(r *StartRequest) { r.Kind = "fix" })
+	if err := m.Store.Claim(j.ID, "skills-test", m.Now()); err != nil {
+		t.Fatal(err)
+	}
+	j = get(t, m, j.ID)
+	work := filepath.Join(m.JobDir(j.ID), "work")
+	if err := os.MkdirAll(work, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.deliverSkills(j, "skills-test", work); err != nil {
+		t.Fatal(err)
+	}
+	j = get(t, m, j.ID)
+	if len(j.SkillsDelivered) == 0 || j.SkillsManifest == "" || j.RepoPath != "" {
+		t.Fatal("fixture must have recorded deliveries and no repository")
+	}
+	if err := os.WriteFile(filepath.Join(m.JobDir(j.ID), "prompt.md"), []byte("original task\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.Store.Finish(j.ID, "skills-test", store.StatusFailed, 7, 0.4, 1, "turn limit", m.Now()); err != nil {
+		t.Fatal(err)
+	}
+	// Admitted while the manifest is still recorded, so the job is queued for its next attempt.
+	if _, err := m.Resume(j.ID, "continue", Limits{}); err != nil {
+		t.Fatalf("resume with a manifest refused at admission: %v", err)
+	}
+	if err := m.Store.Claim(j.ID, "resume-test", m.Now()); err != nil {
+		t.Fatal(err)
+	}
+	// Turn the claimed row into a legacy one: names recorded, manifest gone.
+	if err := m.Store.SetSkillsDelivered(j.ID, "resume-test", j.SkillsDelivered, j.SkillsNote); err != nil {
+		t.Fatal(err)
+	}
+	legacy := get(t, m, j.ID)
+	if len(legacy.SkillsDelivered) == 0 || legacy.SkillsManifest != "" {
+		t.Fatalf("fixture must be a legacy row: delivered=%v manifest=%q", legacy.SkillsDelivered, legacy.SkillsManifest)
+	}
+	_, err := m.prepareResume(legacy, "resume-test")
+	if err == nil || !strings.Contains(err.Error(), "no verifiable baseline") {
+		t.Fatalf("queued legacy delivery must be refused at launch: %v", err)
+	}
+}
