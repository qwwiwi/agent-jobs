+			{Key: "T1", Title: "orders"},
+			{Key: "T2", Title: "margin", DependsOn: deps("T1")}, // no reason
+			{Key: "T3", Title: "history", DependsOn: deps("T1", "T2"),
+				DependsWhy: &map[string]string{"T1": "both edit internal/orders/place.go"}}, // T2 has none
+		}})
