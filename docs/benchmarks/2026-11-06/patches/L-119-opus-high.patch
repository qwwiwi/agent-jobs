+// #119: when ready tasks wait and the agent runs fewer jobs than max_running, the daemon types one
+// "[jobs:slots]" line into the session; it repeats only when the free slots or the ready set change.
+func TestIdleSlotNudge(t *testing.T) {
+	m := newManager(t)
+	logf := filepath.Join(t.TempDir(), "tmux.log")
+	t.Setenv("FAKE_TMUX_LOG", logf)
+	m.Cfg.NotifyTmuxTarget = "fake-session"
+	three := 3
+	m.Cfg.MaxRunning = &three
+	ctx := context.Background()
+	v, err := m.CreateMilestone(ctx, MilestoneCreate{Title: "train", Tasks: []MilestoneTaskInput{
+		{Key: "T1", Title: "a"}, {Key: "T2", Title: "b"},
+		{Key: "T3", Title: "c", DependsOn: deps("T1"), DependsWhy: why("T1")},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	capped, err := m.CreateMilestone(ctx, MilestoneCreate{Title: "serial", MaxParallel: 1, Tasks: []MilestoneTaskInput{
+		{Key: "S1", Title: "x"}, {Key: "S2", Title: "y"}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	lines := func() []string {
+		b, err := os.ReadFile(logf)
+		if os.IsNotExist(err) {
+			return nil
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		var out []string
+		for _, l := range strings.Split(strings.TrimSpace(string(b)), "\n") {
+			if strings.Contains(l, "[jobs:slots]") {
+				out = append(out, l)
+			}
+		}
+		return out
+	}
+	tick := func() {
+		t.Helper()
+		if err := m.Tick(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	tick()
+	want := fmt.Sprintf("-l|[jobs:slots] 3 slots free, ready: milestone %d T1, T2; milestone %d S1|", v.ID, capped.ID)
+	if got := lines(); len(got) != 1 || !strings.HasSuffix(got[0], want) {
+		t.Fatalf("first nudge: %q, want suffix %q", got, want)
+	}
+	tick() // nothing changed: no second line
+	if got := lines(); len(got) != 1 {
+		t.Fatalf("repeated nudge: %q", got)
+	}
+	// A job on S1 fills the capped milestone (max_parallel 1) and a slot: the line changes once.
+	enqueue(t, m, "FAKE_SLEEP=20", func(r *StartRequest) { r.Milestone, r.Task = capped.ID, "S1" })
+	tick()
+	want = fmt.Sprintf("-l|[jobs:slots] 2 slots free, ready: milestone %d T1, T2|", v.ID)
+	if got := lines(); len(got) != 2 || !strings.HasSuffix(got[1], want) {
+		t.Fatalf("after S1 started: %q, want suffix %q", got, want)
+	}
+	// Every slot taken: no line, whatever is ready.
+	enqueue(t, m, "FAKE_SLEEP=20", func(r *StartRequest) { r.Milestone, r.Task = v.ID, "T1" })
+	enqueue(t, m, "FAKE_SLEEP=20", func(r *StartRequest) { r.Milestone, r.Task = v.ID, "T2" })
+	tick()
+	if got := lines(); len(got) != 2 {
+		t.Fatalf("no free slot, yet a line: %q", got)
+	}
+}
