+// #119 guardrail: tasks whose touches overlap are serialized by a derived edge (the later waits for the
+// earlier) unless a dependency path already orders them; derived edges follow the paths on every edit.
+func TestMilestoneTouchesDeriveEdges(t *testing.T) {
+	m := newManager(t)
+	ctx := context.Background()
+	v, err := m.CreateMilestone(ctx, MilestoneCreate{Title: "train", Tasks: []MilestoneTaskInput{
+		{Key: "T1", Title: "orders", Touches: deps("./internal/order/")},
+		{Key: "T2", Title: "book", Touches: deps("internal/order/book.go")},
+		{Key: "T3", Title: "history", Touches: deps("web/history")},
+		{Key: "T4", Title: "margin", Touches: deps("internal/order/*.go"), DependsOn: deps("T2"), DependsWhy: why("T2")},
+		{Key: "T5", Title: "no paths"},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t1, t2, t3, t4 := taskOf(t, v, "T1"), taskOf(t, v, "T2"), taskOf(t, v, "T3"), taskOf(t, v, "T4")
+	if !slices.Equal(t1.Touches, []string{"internal/order"}) || !slices.Equal(t4.Touches, []string{"internal/order"}) {
+		t.Fatalf("normalized touches: T1 %v T4 %v", t1.Touches, t4.Touches)
+	}
+	if !slices.Equal(t2.DependsOn, []string{"T1"}) || t2.DependsWhy["T1"] != "auto: shared paths internal/order/book.go" {
+		t.Fatalf("T2 derived edge: %v %v", t2.DependsOn, t2.DependsWhy)
+	}
+	if len(t3.DependsOn) != 0 || !slices.Equal(t4.DependsOn, []string{"T2"}) {
+		t.Fatalf("T3 %v, T4 %v: T4 reaches T1 through T2 and needs no edge of its own", t3.DependsOn, t4.DependsOn)
+	}
+	if !slices.Equal(v.Ready, []string{"T1", "T3", "T5"}) {
+		t.Fatalf("ready %v", v.Ready)
+	}
+	// T2 moves to other paths: its derived edge goes, and T4 (no longer ordered after T1) gets one.
+	v, err = m.SetMilestone(ctx, MilestoneSet{ID: v.ID, Tasks: []MilestoneTaskInput{{Key: "T2", Touches: deps("docs")}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t2, t4 = taskOf(t, v, "T2"), taskOf(t, v, "T4")
+	if len(t2.DependsOn) != 0 || len(t2.DependsWhy) != 0 {
+		t.Fatalf("T2 kept a stale derived edge: %v %v", t2.DependsOn, t2.DependsWhy)
+	}
+	if !slices.Equal(t4.DependsOn, []string{"T2", "T1"}) || t4.DependsWhy["T1"] != "auto: shared paths internal/order" ||
+		t4.DependsWhy["T2"] != why("T2")["T2"] {
+		t.Fatalf("T4: %v %v", t4.DependsOn, t4.DependsWhy)
+	}
+	// A dropped task holds nothing back: dropping T1 leaves T4 only its own edge (T1 is ignored).
+	v, err = m.SetMilestone(ctx, MilestoneSet{ID: v.ID, Drop: []string{"T1"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if t4 = taskOf(t, v, "T4"); !slices.Equal(t4.DependsOn, []string{"T2"}) {
+		t.Fatalf("T4 after dropping T1: %v", t4.DependsOn)
+	}
+}
