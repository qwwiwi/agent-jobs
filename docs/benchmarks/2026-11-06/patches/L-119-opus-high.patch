+++ b/internal/jobs/milestone_slots.go
@@ -0,0 +1,144 @@
+package jobs
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/qwwiwi/agent-jobs/internal/store"
+)
+
+// Idle-slot nudge (#119): ready tasks of open milestones get a job only when the orchestrator starts one.
+// When the agent has free slots (max_running minus running and queued jobs) and ready tasks wait, the
+// daemon types one line into the orchestrator session through the job-done tmux path:
+//
+//	[jobs:slots] 3 slots free, ready: milestone 4 T8, T9; milestone 7 T2
+//
+// It is sent again only when the free count or the ready set changes, so an idle orchestrator is not
+// flooded once a minute.
+
+// SlotsTag starts the idle-slot line.
+const SlotsTag = "[jobs:slots]"
+
+// maxSlotKeys caps the ready keys named on one line; the rest are counted.
+const maxSlotKeys = 20
+
+// readyMilestone is the ready tasks of one open milestone a job could start on now.
+type readyMilestone struct {
+	ID   int64
+	Keys []string
+}
+
+// SlotsLine is the idle-slot line for free slots and the ready tasks ("" when there is nothing to say).
+func SlotsLine(free int, ready []readyMilestone) string {
+	if free <= 0 || len(ready) == 0 {
+		return ""
+	}
+	var parts []string
+	named, more := 0, 0
+	for _, r := range ready {
+		var keys []string
+		for _, k := range r.Keys {
+			if named >= maxSlotKeys {
+				more++
+				continue
+			}
+			keys = append(keys, k)
+			named++
+		}
+		if len(keys) > 0 {
+			parts = append(parts, fmt.Sprintf("milestone %d %s", r.ID, strings.Join(keys, ", ")))
+		}
+	}
+	slots := "slots"
+	if free == 1 {
+		slots = "slot"
+	}
+	line := fmt.Sprintf("%s %d %s free, ready: %s", SlotsTag, free, slots, strings.Join(parts, "; "))
+	if more > 0 {
+		line += fmt.Sprintf(" (+%d more)", more)
+	}
+	return line
+}
+
+// readyForSlots lists, per open milestone, the ready tasks (no job yet, every dependency done) a job may
+// start on now: a milestone at its max_parallel (running and queued jobs) offers none, one below it at
+// most the slots it has left.
+func (m *Manager) readyForSlots(ctx context.Context) ([]readyMilestone, error) {
+	open, err := m.Store.ListMilestones(ctx, store.MilestoneFilter{Status: store.MilestoneOpen})
+	if err != nil {
+		return nil, err
+	}
+	var out []readyMilestone
+	for _, ms := range open {
+		tasks, err := m.Store.MilestoneTasks(ctx, ms.ID)
+		if err != nil {
+			return nil, err
+		}
+		jobs, err := m.Store.MilestoneJobs(ctx, ms.ID)
+		if err != nil {
+			return nil, err
+		}
+		left := -1
+		if ms.MaxParallel != nil {
+			busy := 0
+			for _, j := range jobs {
+				if j.Status == store.StatusRunning || j.Status == store.StatusQueued {
+					busy++
+				}
+			}
+			if left = *ms.MaxParallel - busy; left <= 0 {
+				continue
+			}
+		}
+		st := TaskStatuses(tasks, jobs)
+		var keys []string
+		for _, t := range tasks {
+			if st[t.Key] == TaskReady && (left < 0 || len(keys) < left) {
+				keys = append(keys, t.Key)
+			}
+		}
+		if len(keys) > 0 {
+			out = append(out, readyMilestone{ID: ms.ID, Keys: keys})
+		}
+	}
+	return out, nil
+}
+
+// nudgeIdleSlots sends the idle-slot line when it differs from the last one sent (under the lifecycle
+// lock, after launchQueued). Without notify_tmux_target it is logged. A failed delivery is logged and
+// tried again next tick.
+func (m *Manager) nudgeIdleSlots() error {
+	running, err := m.Store.CountRunning()
+	if err != nil {
+		return err
+	}
+	queued, err := m.Store.ListByStatus(store.StatusQueued)
+	if err != nil {
+		return err
+	}
+	free := m.Config().MaxRunningJobs() - running - len(queued)
+	line := ""
+	if free > 0 {
+		ready, err := m.readyForSlots(context.Background())
+		if err != nil {
+			return err
+		}
+		line = SlotsLine(free, ready)
+	}
+	if line == "" || line == m.lastSlotsLine {
+		if line == "" {
+			m.lastSlotsLine = "" // the next free slot with ready tasks is news again
+		}
+		return nil
+	}
+	if t := m.Config().NotifyTmuxTarget; t == "" {
+		m.Log.Printf("notify off (notify_tmux_target not configured): %s", line)
+	} else if err := m.sendTmuxLocked(t, line); err != nil {
+		// A nudge is advice, never a tick failure: logged, and tried again next tick.
+		m.Log.Printf("idle slots line not delivered, retry next tick: %s", RedactText(err.Error()))
+		return nil
+	}
+	m.lastSlotsLine = line
+	return nil
+}
