index 0000000..3c593ef
--- /dev/null
+++ b/internal/jobs/milestone_edges.go
@@ -0,0 +1,252 @@
+package jobs
+
+import (
+	"fmt"
+	"maps"
+	"path"
+	"slices"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/qwwiwi/agent-jobs/internal/store"
+)
+
+// Dependency edges of a milestone (#119). Every depends_on edge carries a one-line reason (depends_why):
+// the files or modules both tasks touch, or the output one consumes. An edge given without a reason is
+// dropped, so a chain stricter than the code needs does not hold independent tasks back. Tasks that list
+// overlapping paths (touches) are serialized by a derived edge, whatever the planner wrote: the guardrail
+// for shared files and money paths.
+
+// Edge limits.
+const (
+	MaxEdgeReasonRunes = 200
+	MaxTaskTouches     = 50
+	MaxTouchRunes      = 200
+)
+
+// edgeReasons validates the depends_why input of a task: every key must be one of deps, every reason one
+// line and not marked as derived (AutoEdgePrefix is the daemon's).
+func edgeReasons(key string, why map[string]string, deps []string) (map[string]string, error) {
+	out := map[string]string{}
+	for _, d := range slices.Sorted(maps.Keys(why)) {
+		dk := strings.TrimSpace(d)
+		if !slices.Contains(deps, dk) {
+			return nil, fmt.Errorf("task %s: depends_why names %q, which is not in its depends_on", key, Printable(dk, 40))
+		}
+		r, err := oneLine("task "+key+" depends_why "+dk, why[d], MaxEdgeReasonRunes, false)
+		if err != nil {
+			return nil, err
+		}
+		if strings.HasPrefix(r, store.AutoEdgePrefix) {
+			return nil, fmt.Errorf("task %s: depends_why %s starts with %q, which marks derived edges", key, dk, store.AutoEdgePrefix)
+		}
+		if r != "" {
+			out[dk] = r
+		}
+	}
+	return out, nil
+}
+
+// setDeps applies a task's depends_on (and depends_why) input to t: an edge keeps a reason given now or
+// the one stored for it (a derived reason is not kept: derivation runs again); an edge without one is
+// dropped and its dependency key returned. Only depends_why (no depends_on) edits the reasons of stored edges.
+func setDeps(t *store.MilestoneTask, deps *[]string, why map[string]string) (dropped []string, err error) {
+	if deps == nil {
+		if why == nil {
+			return nil, nil
+		}
+		given, err := edgeReasons(t.Key, why, manualDeps(*t))
+		if err != nil {
+			return nil, err
+		}
+		next := maps.Clone(t.DependsWhy)
+		if next == nil {
+			next = map[string]string{}
+		}
+		maps.Copy(next, given)
+		t.DependsWhy = next
+		return nil, nil
+	}
+	keys := trimList(*deps)
+	given, err := edgeReasons(t.Key, why, keys)
+	if err != nil {
+		return nil, err
+	}
+	nextDeps, nextWhy := []string{}, map[string]string{}
+	for _, d := range keys {
+		r := given[d]
+		if r == "" {
+			if old := t.DependsWhy[d]; !strings.HasPrefix(old, store.AutoEdgePrefix) {
+				r = old
+			}
+		}
+		if r == "" {
+			dropped = append(dropped, d)
+			continue
+		}
+		nextDeps, nextWhy[d] = append(nextDeps, d), r
+	}
+	t.DependsOn, t.DependsWhy = nextDeps, nextWhy
+	return dropped, nil
+}
+
+// manualDeps are the depends_on keys of t whose edge was not derived.
+func manualDeps(t store.MilestoneTask) []string {
+	var out []string
+	for _, d := range t.DependsOn {
+		if !strings.HasPrefix(t.DependsWhy[d], store.AutoEdgePrefix) {
+			out = append(out, d)
+		}
+	}
+	return out
+}
+
+// normTouches validates and normalizes the touches of a task: repo-relative paths of files or directories,
+// cleaned, without a leading "./" or a trailing "/". A glob is cut to the directory before its first
+// wildcard segment (internal/order/*.go -> internal/order): overlap is judged conservatively.
+func normTouches(key string, in []string) ([]string, error) {
+	out := []string{}
+	for _, raw := range in {
+		p := strings.TrimSpace(raw)
+		if p == "" {
+			continue
+		}
+		if !utf8.ValidString(p) || containsControl(p) || strings.Contains(p, ",") || utf8.RuneCountInString(p) > MaxTouchRunes {
+			return nil, fmt.Errorf("task %s: touches %q must be one repo-relative path without commas, at most %d characters",
+				key, Printable(p, 40), MaxTouchRunes)
+		}
+		if strings.HasPrefix(p, "/") {
+			return nil, fmt.Errorf("task %s: touches %q must be relative to the repository", key, Printable(p, 40))
+		}
+		if i := strings.IndexAny(p, "*?["); i >= 0 {
+			p = p[:i]
+			if j := strings.LastIndex(p, "/"); j >= 0 {
+				p = p[:j]
+			} else {
+				p = "."
+			}
+		}
+		p = path.Clean(p)
+		if p == ".." || strings.HasPrefix(p, "../") {
+			return nil, fmt.Errorf("task %s: touches %q leaves the repository", key, Printable(raw, 40))
+		}
+		if !slices.Contains(out, p) {
+			out = append(out, p)
+		}
+	}
+	if len(out) > MaxTaskTouches {
+		return nil, fmt.Errorf("task %s: at most %d touches", key, MaxTaskTouches)
+	}
+	return out, nil
+}
+
+// pathsOverlap reports whether two normalized paths name the same file or one lies inside the other
+// ("." is the whole repository).
+func pathsOverlap(a, b string) bool {
+	return a == b || a == "." || b == "." || strings.HasPrefix(b, a+"/") || strings.HasPrefix(a, b+"/")
+}
+
+// sharedPaths lists the paths of a that overlap a path of b (the narrower of the two), in a's order.
+func sharedPaths(a, b []string) []string {
+	var out []string
+	for _, x := range a {
+		for _, y := range b {
+			if !pathsOverlap(x, y) {
+				continue
+			}
+			p := x
+			if x == "." || (y != "." && len(y) > len(x)) {
+				p = y
+			}
+			if !slices.Contains(out, p) {
+				out = append(out, p)
+			}
+		}
+	}
+	return out
+}
+
+// deriveEdges serializes tasks whose touches overlap (#119 guardrail): derived edges are dropped and
+// derived again from the current paths; for two live tasks sharing a path with no dependency path between
+// them either way, the later one (task order) waits for the earlier one, reason "auto: shared paths ...".
+// Edges are added in task order, each against the graph so far, so none closes a cycle.
+func deriveEdges(all []store.MilestoneTask) error {
+	idx := map[string]int{}
+	for i := range all {
+		idx[all[i].Key] = i
+		t := &all[i]
+		keep := manualDeps(*t)
+		if len(keep) == len(t.DependsOn) {
+			continue
+		}
+		why := map[string]string{}
+		for _, d := range keep {
+			if r, ok := t.DependsWhy[d]; ok {
+				why[d] = r
+			}
+		}
+		t.DependsOn, t.DependsWhy = keep, why
+	}
+	for j := range all {
+		if all[j].Dropped || len(all[j].Touches) == 0 {
+			continue
+		}
+		for i := 0; i < j; i++ {
+			if all[i].Dropped || len(all[i].Touches) == 0 {
+				continue
+			}
+			shared := sharedPaths(all[j].Touches, all[i].Touches)
+			if len(shared) == 0 || reaches(all, idx, j, i) || reaches(all, idx, i, j) {
+				continue
+			}
+			t := &all[j]
+			// The task's list and map may be shared with the caller's copy of the stored tasks: never
+			// written in place.
+			t.DependsOn, t.DependsWhy = slices.Clone(t.DependsOn), maps.Clone(t.DependsWhy)
+			if len(t.DependsOn) >= MaxTaskDeps {
+				return fmt.Errorf("task %s: at most %d depends_on, with the edges derived from shared touches", t.Key, MaxTaskDeps)
+			}
+			reason := store.AutoEdgePrefix + "shared paths " + strings.Join(shared, ", ")
+			if utf8.RuneCountInString(reason) > MaxEdgeReasonRunes {
+				reason = string([]rune(reason)[:MaxEdgeReasonRunes-3]) + "..."
+			}
+			if t.DependsWhy == nil {
+				t.DependsWhy = map[string]string{}
+			}
+			t.DependsOn = append(t.DependsOn, all[i].Key)
+			t.DependsWhy[all[i].Key] = reason
+		}
+	}
+	return nil
+}
+
+// reaches reports whether task from waits for task to, directly or through other tasks.
+func reaches(all []store.MilestoneTask, idx map[string]int, from, to int) bool {
+	seen := map[int]bool{}
+	stack := []int{from}
+	for len(stack) > 0 {
+		n := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		if seen[n] {
+			continue
+		}
+		seen[n] = true
+		for _, d := range all[n].DependsOn {
+			k, ok := idx[d]
+			if !ok {
+				continue
+			}
+			if k == to {
+				return true
+			}
+			stack = append(stack, k)
+		}
+	}
+	return false
+}
+
+// sameTask reports whether a and b store the same dependencies and touches (the parts deriveEdges may
+// change of a task the input did not name).
+func sameTask(a, b store.MilestoneTask) bool {
+	return slices.Equal(a.DependsOn, b.DependsOn) && maps.Equal(a.DependsWhy, b.DependsWhy) && slices.Equal(a.Touches, b.Touches)
+}
diff --git a/internal/jobs/milestone_slots.go b/internal/jobs/milestone_slots.go
