diff --git a/internal/store/milestones_edges_test.go b/internal/store/milestones_edges_test.go
new file mode 100644
index 0000000..352ab57
--- /dev/null
+++ b/internal/store/milestones_edges_test.go
@@ -0,0 +1,61 @@
+package store
+
+import (
+	"context"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// #119: a milestone_tasks table from before the depends_why and touches columns gains them on Open (its
+// edges keep no reason); the reasons and touches of a task round-trip through create and update.
+func TestMilestoneTaskEdgeReasonsColumns(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "jobs.db")
+	s, err := Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.db.Exec(`DROP TABLE milestone_tasks; CREATE TABLE milestone_tasks (
+		milestone_id INTEGER NOT NULL, key TEXT NOT NULL, title TEXT NOT NULL, depends_on TEXT NOT NULL DEFAULT '',
+		covers TEXT NOT NULL DEFAULT '', dropped INTEGER NOT NULL DEFAULT 0, created_at INTEGER NOT NULL,
+		updated_at INTEGER NOT NULL, skills TEXT NOT NULL DEFAULT '', sources TEXT NOT NULL DEFAULT '',
+		PRIMARY KEY (milestone_id, key));
+		INSERT INTO milestones (title, status, created_at, updated_at) VALUES ('old', 'open', 1, 1);
+		INSERT INTO milestone_tasks (milestone_id, key, title, created_at, updated_at) VALUES (1, 'T1', 'old', 1, 1);
+		INSERT INTO milestone_tasks (milestone_id, key, title, depends_on, created_at, updated_at) VALUES (1, 'T2', 'old', 'T1', 1, 1)`); err != nil {
+		t.Fatal(err)
+	}
+	_ = s.Close()
+	if s, err = Open(path); err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	ctx := context.Background()
+	tasks, err := s.MilestoneTasks(ctx, 1)
+	if err != nil || len(tasks) != 2 || fmt.Sprint(tasks[1].DependsOn) != "[T1]" || tasks[1].DependsWhy != nil || tasks[1].Touches != nil {
+		t.Fatalf("legacy tasks: %+v %v", tasks, err)
+	}
+	id, err := s.CreateMilestone(&Milestone{Title: "new"}, []MilestoneTask{
+		{Key: "T1", Title: "one", Touches: []string{"internal/order"}},
+		{Key: "T2", Title: "two", DependsOn: []string{"T1"}, DependsWhy: map[string]string{"T1": "both edit internal/order, \"quoted\""}}},
+		time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	tasks, err = s.MilestoneTasks(ctx, id)
+	if err != nil || fmt.Sprint(tasks[0].Touches) != "[internal/order]" || tasks[0].DependsWhy != nil ||
+		tasks[1].DependsWhy["T1"] != `both edit internal/order, "quoted"` {
+		t.Fatalf("round trip: %+v %v", tasks, err)
+	}
+	err = s.UpdateMilestone(ctx, id, time.Now(), func(ms *Milestone, ts []MilestoneTask, _ []*Job) (*Milestone, []MilestoneTask, error) {
+		ts[1].DependsOn, ts[1].DependsWhy, ts[1].Touches = nil, nil, []string{"docs"}
+		return ms, ts[1:], nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tasks, _ = s.MilestoneTasks(ctx, id); tasks[1].DependsOn != nil || tasks[1].DependsWhy != nil || fmt.Sprint(tasks[1].Touches) != "[docs]" {
+		t.Fatalf("update: %+v", tasks[1])
+	}
+}
