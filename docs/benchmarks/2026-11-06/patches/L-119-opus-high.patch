@@ -0,0 +1,249 @@
+package jobs
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/qwwiwi/agent-jobs/internal/store"
+)
+
+// #119: every depends_on edge carries a reason; an edge given without one is dropped and named in
+// dropped_edges, so independent tasks are not held back by a chain stricter than the code needs.
+func TestMilestoneEdgeNeedsReason(t *testing.T) {
+	m := newManager(t)
+	ctx := context.Background()
+	v, err := m.CreateMilestone(ctx, MilestoneCreate{Title: "train", Tasks: []MilestoneTaskInput{
+		{Key: "T1", Title: "orders"},
+		{Key: "T2", Title: "login", DependsOn: deps("T1")},
+		{Key: "T3", Title: "order book", DependsOn: deps("T1"), DependsWhy: map[string]string{"T1": " both edit internal/order "}},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Equal(v.DroppedEdges, []string{"T2->T1"}) {
+		t.Fatalf("dropped_edges %v, want [T2->T1]", v.DroppedEdges)
+	}
+	if t2 := taskOf(t, v, "T2"); len(t2.DependsOn) != 0 || t2.Status != TaskReady {
+		t.Fatalf("T2 kept an edge without a reason: %+v", t2)
+	}
+	t3 := taskOf(t, v, "T3")
+	if !slices.Equal(t3.DependsOn, []string{"T1"}) || t3.DependsWhy["T1"] != "both edit internal/order" || t3.Status != TaskBlocked {
+		t.Fatalf("T3: %+v", t3)
+	}
+	if !slices.Equal(v.Ready, []string{"T1", "T2"}) {
+		t.Fatalf("ready %v, want T1 T2", v.Ready)
+	}
+	// The reason is stored: a milestone_get sees it, and a set that lists the edge again keeps it.
+	v, err = m.SetMilestone(ctx, MilestoneSet{ID: v.ID, Tasks: []MilestoneTaskInput{{Key: "T3", DependsOn: deps("T1")}}})
+	if err != nil || len(v.DroppedEdges) != 0 || taskOf(t, v, "T3").DependsWhy["T1"] != "both edit internal/order" {
+		t.Fatalf("relisted edge: %+v %v", v, err)
+	}
+	// depends_why alone edits the reason of a stored edge.
+	v, err = m.SetMilestone(ctx, MilestoneSet{ID: v.ID, Tasks: []MilestoneTaskInput{{Key: "T3", DependsWhy: map[string]string{"T1": "reads the order table"}}}})
+	if err != nil || taskOf(t, v, "T3").DependsWhy["T1"] != "reads the order table" {
+		t.Fatalf("reason edit: %+v %v", v, err)
+	}
+	got, err := m.MilestoneTree(ctx, v.ID)
+	if err != nil || len(got.DroppedEdges) != 0 || taskOf(t, got, "T3").DependsWhy["T1"] != "reads the order table" {
+		t.Fatalf("stored: %+v %v", got, err)
+	}
+
+	for name, c := range map[string]struct {
+		in   []MilestoneTaskInput
+		want string
+	}{
+		"reason for a key not in depends_on": {[]MilestoneTaskInput{{Key: "T1", Title: "a"}, {Key: "T2", Title: "b",
+			DependsOn: deps("T1"), DependsWhy: map[string]string{"T1": "x", "T9": "y"}}}, "not in its depends_on"},
+		"reason marked as derived": {[]MilestoneTaskInput{{Key: "T1", Title: "a"}, {Key: "T2", Title: "b",
+			DependsOn: deps("T1"), DependsWhy: map[string]string{"T1": "auto: shared paths x"}}}, "derived edges"},
+		"reason on two lines": {[]MilestoneTaskInput{{Key: "T1", Title: "a"}, {Key: "T2", Title: "b",
+			DependsOn: deps("T1"), DependsWhy: map[string]string{"T1": "a\nb"}}}, "control character"},
+		"unknown key without a reason": {[]MilestoneTaskInput{{Key: "T1", Title: "a", DependsOn: deps("T9")}}, "not a task"},
+		"itself without a reason":      {[]MilestoneTaskInput{{Key: "T1", Title: "a", DependsOn: deps("T1")}}, "itself"},
+		"absolute touches":             {[]MilestoneTaskInput{{Key: "T1", Title: "a", Touches: deps("/etc/passwd")}}, "relative to the repository"},
+		"touches out of the repo":      {[]MilestoneTaskInput{{Key: "T1", Title: "a", Touches: deps("src/../../x")}}, "leaves the repository"},
+		"touches with a comma":         {[]MilestoneTaskInput{{Key: "T1", Title: "a", Touches: deps("a,b")}}, "without commas"},
+	} {
+		if _, err := m.CreateMilestone(ctx, MilestoneCreate{Title: "bad", Tasks: c.in}); err == nil || !strings.Contains(err.Error(), c.want) {
+			t.Errorf("%s: %v, want %q", name, err, c.want)
+		}
+	}
+}
