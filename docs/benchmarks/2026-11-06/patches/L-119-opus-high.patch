+// #119 acceptance: a milestone of independent tasks, created without max_parallel, fills every slot of
+// the agent's max_running in one tick: no milestone cap of its own holds them back.
+func TestMilestoneIndependentTasksFillAllSlots(t *testing.T) {
+	m := newManager(t)
+	five := 5
+	m.Cfg.MaxRunning = &five
+	ctx := context.Background()
+	var in []MilestoneTaskInput
+	for i := 1; i <= 6; i++ {
+		in = append(in, MilestoneTaskInput{Key: fmt.Sprintf("T%d", i), Title: "independent", Touches: deps(fmt.Sprintf("mod%d", i))})
+	}
+	v, err := m.CreateMilestone(ctx, MilestoneCreate{Title: "train", Tasks: in})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v.MaxParallel != nil || len(v.Ready) != 6 {
+		t.Fatalf("max_parallel %v, ready %v", v.MaxParallel, v.Ready)
+	}
+	for _, k := range v.Ready {
+		enqueue(t, m, "FAKE_SLEEP=20", func(r *StartRequest) { r.Milestone, r.Task = v.ID, k })
+	}
+	if err := m.Tick(); err != nil {
+		t.Fatal(err)
+	}
+	n, _ := m.Store.CountRunning()
+	q, _ := m.Store.ListByStatus(store.StatusQueued)
+	if n != 5 || len(q) != 1 {
+		t.Fatalf("running=%d queued=%d, want 5 and 1", n, len(q))
+	}
+}
