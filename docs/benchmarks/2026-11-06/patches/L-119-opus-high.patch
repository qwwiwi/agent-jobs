+// #119: the idle-slot line names the free slots and the ready tasks, capped, and respects max_parallel.
+func TestSlotsLine(t *testing.T) {
+	if got := SlotsLine(0, []readyMilestone{{ID: 1, Keys: []string{"T1"}}}); got != "" {
+		t.Fatalf("no free slot: %q", got)
+	}
+	if got := SlotsLine(2, nil); got != "" {
+		t.Fatalf("nothing ready: %q", got)
+	}
+	if got, want := SlotsLine(3, []readyMilestone{{ID: 4, Keys: []string{"T8", "T9"}}, {ID: 7, Keys: []string{"T2"}}}),
+		"[jobs:slots] 3 slots free, ready: milestone 4 T8, T9; milestone 7 T2"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+	var keys []string
+	for i := 1; i <= maxSlotKeys+3; i++ {
+		keys = append(keys, fmt.Sprintf("T%d", i))
+	}
+	if got := SlotsLine(1, []readyMilestone{{ID: 2, Keys: keys}}); !strings.HasPrefix(got, "[jobs:slots] 1 slot free, ready: milestone 2 T1, T2,") ||
+		!strings.HasSuffix(got, fmt.Sprintf("T%d (+3 more)", maxSlotKeys)) {
+		t.Fatalf("capped line: %q", got)
+	}
+}
