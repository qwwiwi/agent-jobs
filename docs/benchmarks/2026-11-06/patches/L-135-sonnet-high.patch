+    assert.equal(resolvePlaywright({ cwd, env: { NODE_PATH: 'node_modules' }, globalRoot: noGlobal, trusted: true }), null);
+    // the trusted global root is used
+    const viaGlobal = resolvePlaywright({ cwd, env: {}, globalRoot: () => path.join(root, 'cwd', 'node_modules'), trusted: true });
