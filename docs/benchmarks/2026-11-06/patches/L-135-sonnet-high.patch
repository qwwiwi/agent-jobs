+  try {
+    const planted = path.join(root, 'cwd', 'node_modules', 'playwright');
+    mkdirSync(planted, { recursive: true });
+    writeFileSync(path.join(planted, 'package.json'), '{"name":"playwright","main":"index.js"}');
+    writeFileSync(path.join(planted, 'index.js'), 'module.exports = {};');
+    const cwd = path.join(root, 'cwd');
