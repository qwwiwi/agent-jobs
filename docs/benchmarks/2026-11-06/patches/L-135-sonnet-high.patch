diff --git a/cmd/agent-jobs/uicheck.go b/cmd/agent-jobs/uicheck.go
new file mode 100644
index 0000000..7c629c5
--- /dev/null
+++ b/cmd/agent-jobs/uicheck.go
@@ -0,0 +1,62 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+
+	agentjobs "github.com/qwwiwi/agent-jobs"
+)
+
+// uiCheckScript is the browser check embedded in the binary.
+const uiCheckScript = "scripts/ui-check.mjs"
+
+// cmdUICheck is `agent-jobs ui-check`: the way the orchestrator runs the browser check. It never runs a
+// copy from a job directory (the job can rewrite it) and never resolves Playwright from the current
+// directory (a job worktree can plant node_modules): it writes the embedded script to a private temp
+// directory and runs it with --trusted (see scripts/ui-check.mjs).
+func cmdUICheck(args []string) error {
+	if code := runUICheck(args, os.Stdout, os.Stderr); code != 0 {
+		os.Exit(code)
+	}
+	return nil
+}
+
+// runUICheck runs the embedded script with node and returns its exit code (0 pass, 1 fail, 2 not run).
+func runUICheck(args []string, stdout, stderr io.Writer) int {
+	notRun := func(format string, a ...any) int {
+		fmt.Fprintf(stdout, "BROWSER CHECK NOT RUN: "+format+"\n", a...)
+		return 2
+	}
+	node, err := exec.LookPath("node")
+	if err != nil {
+		return notRun("node not found in PATH")
+	}
+	script, err := agentjobs.Templates.ReadFile(uiCheckScript)
+	if err != nil {
+		return notRun("embedded %s: %v", uiCheckScript, err)
+	}
+	dir, err := os.MkdirTemp("", "agent-jobs-ui-check-") // mode 0700
+	if err != nil {
+		return notRun("private temp dir: %v", err)
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, filepath.Base(uiCheckScript))
+	if err := os.WriteFile(path, script, 0o600); err != nil {
+		return notRun("write %s: %v", path, err)
+	}
+	cmd := exec.Command(node, append([]string{path, "--trusted"}, args...)...)
+	cmd.Stdout, cmd.Stderr, cmd.Stdin = stdout, stderr, nil
+	var exit *exec.ExitError
+	switch err := cmd.Run(); {
+	case err == nil:
+		return 0
+	case errors.As(err, &exit) && exit.ExitCode() > 0:
+		return exit.ExitCode()
+	default:
+		return notRun("node: %v", err)
+	}
+}
diff --git a/cmd/agent-jobs/uicheck_test.go b/cmd/agent-jobs/uicheck_test.go
new file mode 100644
index 0000000..93f7064
--- /dev/null
+++ b/cmd/agent-jobs/uicheck_test.go
@@ -0,0 +1,130 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// uiCheckSandbox builds a fake job worktree that plants both attack vectors of #135 (a tools/ui-check.mjs
+// and a node_modules/playwright that write a sentinel file when executed) and a PATH with only node and
+// a fake npm (whose global root does not exist; it records the directory it ran in).
+type uiCheckSandbox struct {
+	work, sentinelDir, npmCwdFile string
+}
+
+func newUICheckSandbox(t *testing.T) uiCheckSandbox {
+	t.Helper()
+	node, err := exec.LookPath("node")
+	if err != nil {
+		t.Skip("node not installed")
+	}
+	root := t.TempDir()
+	sb := uiCheckSandbox{work: filepath.Join(root, "work"), sentinelDir: filepath.Join(root, "sentinels"), npmCwdFile: filepath.Join(root, "npm-cwd")}
+	bin := filepath.Join(root, "bin")
+	for _, d := range []string{sb.work, sb.sentinelDir, bin, filepath.Join(sb.work, "tools"), filepath.Join(sb.work, "node_modules", "playwright")} {
+		if err := os.MkdirAll(d, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.Symlink(node, filepath.Join(bin, "node")); err != nil {
+		t.Fatal(err)
+	}
+	npm := "#!/bin/sh\npwd > '" + sb.npmCwdFile + "'\necho '" + filepath.Join(root, "no-global-root") + "'\n"
+	write := func(p, s string) {
+		if err := os.WriteFile(p, []byte(s), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(filepath.Join(bin, "npm"), npm)
+	write(filepath.Join(sb.work, "tools", "ui-check.mjs"), "import fs from 'node:fs'; fs.writeFileSync('"+filepath.Join(sb.sentinelDir, "planted-tool")+"', 'x');\n")
+	write(filepath.Join(sb.work, "node_modules", "playwright", "package.json"), `{"name":"playwright","main":"index.js"}`)
+	write(filepath.Join(sb.work, "node_modules", "playwright", "index.js"),
+		"require('fs').writeFileSync('"+filepath.Join(sb.sentinelDir, "planted-playwright")+"', 'x');\nexports.chromium = { launch: async () => { throw new Error('planted launch'); } };\n")
+	t.Setenv("PATH", bin)
+	t.Setenv("NODE_PATH", "")
+	t.Setenv("NODE_OPTIONS", "")
+	t.Chdir(sb.work)
+	return sb
+}
+
+func (sb uiCheckSandbox) planted(t *testing.T, name string) bool {
+	t.Helper()
+	_, err := os.Stat(filepath.Join(sb.sentinelDir, name))
+	return err == nil
+}
+
+// The trusted run never executes the job-dir tool and never resolves Playwright from the worktree's
+// node_modules (#135): with no other Playwright it reports "not run" (exit 2).
+func TestUICheckIgnoresPlantedToolAndPlaywright(t *testing.T) {
+	sb := newUICheckSandbox(t)
+	var out, errb bytes.Buffer
+	code := runUICheck([]string{"http://127.0.0.1:1", "/"}, &out, &errb)
+	if code != 2 {
+		t.Fatalf("exit %d, want 2 (Playwright not found); out=%q err=%q", code, out.String(), errb.String())
+	}
+	if !strings.Contains(out.String(), "BROWSER CHECK NOT RUN: Playwright not found") {
+		t.Fatalf("output lacks the not-run line: %q", out.String())
+	}
+	if sb.planted(t, "planted-playwright") {
+		t.Fatal("the planted node_modules/playwright in the worktree was executed")
+	}
+	if sb.planted(t, "planted-tool") {
+		t.Fatal("the planted tools/ui-check.mjs in the worktree was executed")
+	}
+	// npm root -g must not run in the worktree either: a planted .npmrc there could redirect the root.
+	got, err := os.ReadFile(sb.npmCwdFile)
+	if err != nil {
+		t.Fatalf("fake npm did not run: %v", err)
+	}
+	if strings.TrimSpace(string(got)) == sb.work {
+		t.Fatal("npm root -g ran in the worktree")
+	}
+}
+
+// --playwright names the trusted Playwright explicitly; it is used instead of the planted one.
+func TestUICheckExplicitPlaywright(t *testing.T) {
+	sb := newUICheckSandbox(t)
+	trusted := filepath.Join(filepath.Dir(sb.work), "trusted", "playwright")
+	if err := os.MkdirAll(trusted, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for name, content := range map[string]string{
+		"package.json": `{"name":"playwright","main":"index.js"}`,
+		"index.js":     "require('fs').writeFileSync('" + filepath.Join(sb.sentinelDir, "trusted") + "', 'x');\nexports.chromium = { launch: async () => { throw new Error('trusted launch'); } };\n",
+	} {
+		if err := os.WriteFile(filepath.Join(trusted, name), []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var out, errb bytes.Buffer
+	code := runUICheck([]string{"--playwright", trusted, "http://127.0.0.1:1", "/"}, &out, &errb)
+	if code != 2 || !strings.Contains(out.String(), "cannot launch Chromium: trusted launch") {
+		t.Fatalf("exit %d, out=%q err=%q; want the trusted module to run", code, out.String(), errb.String())
+	}
+	if !sb.planted(t, "trusted") {
+		t.Fatal("the --playwright module was not loaded")
+	}
+	if sb.planted(t, "planted-playwright") || sb.planted(t, "planted-tool") {
+		t.Fatal("planted worktree code was executed")
+	}
+}
+
+// The embedded script is written to a private temp dir that is gone after the run.
+func TestUICheckTempDirPrivateAndRemoved(t *testing.T) {
+	newUICheckSandbox(t)
+	tmp := t.TempDir()
+	t.Setenv("TMPDIR", tmp)
+	var out, errb bytes.Buffer
+	runUICheck([]string{"--help"}, &out, &errb)
+	left, err := os.ReadDir(tmp)
+	if err != nil || len(left) != 0 {
+		t.Fatalf("temp dir not cleaned: %v %v", left, err)
+	}
+	if !strings.Contains(out.String(), "usage: node ui-check.mjs") {
+		t.Fatalf("--help output: %q", out.String())
+	}
+}
