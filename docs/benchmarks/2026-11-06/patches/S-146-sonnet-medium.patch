+// checkOpenRouterSources refuses sources that would carry a denied repository's content to the provider
+// (#146): a file inside a repository matching deny_repos, or the report of a job run on one.
+func (m *Manager) checkOpenRouterSources(origins []string) error {
+	o := m.Config().Providers.OpenRouter
+	if o == nil {
+		return nil
+	}
+	for _, origin := range origins {
+		var repos []string
+		if id, ok := strings.CutPrefix(origin, "job:"); ok {
+			// An unknown job is refused later, when the snapshot is taken.
+			if j, err := m.Store.Get(id); err == nil && j.RepoPath != "" {
+				repos = append(repos, j.RepoPath)
+			}
+		} else {
+			repos = sourceFileRepos(origin)
+		}
+		for _, repo := range repos {
+			if d := o.deniedRepo(repo); d != "" {
+				return fmt.Errorf("sources %q belong to repository %s, denied to openrouter jobs (providers.openrouter.deny_repos %q)", origin, repo, d)
+			}
+		}
+	}
+	return nil
+}
+
+// sourceFileRepos returns the repository roots (work tree and main worktree) that contain the file at
+// path, resolving symlinks; none when the file is outside any git repository.
+func sourceFileRepos(path string) []string {
+	dir := filepath.Dir(path)
+	if real, err := filepath.EvalSymlinks(dir); err == nil {
+		dir = real
+	}
+	top, err := git(dir, "rev-parse", "--show-toplevel")
+	if err != nil {
+		return nil
+	}
+	return []string{top, mainWorktree(top)}
+}
