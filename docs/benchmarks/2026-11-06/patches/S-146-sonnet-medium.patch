+// #146: file and job sources of a denied repository never reach an openrouter job.
+func TestOpenRouterSourcesRespectDenyRepos(t *testing.T) {
+	m := newManager(t)
+	m.Cfg.Providers.OpenRouter = orConfig(DefaultOpenRouterBaseURL, "/k")
+	m.Cfg.Providers.OpenRouter.DailyCapUSD = f64(50)
+	denied := newRepo(t)
+	m.Cfg.Providers.OpenRouter.DenyRepos = []string{filepath.Base(denied)}
+	secret := sourceFixture(t, denied, "secret.md", "private")
+	outside := sourceFixture(t, t.TempDir(), "notes.md", "notes")
+	start := func(src string) error {
+		_, err := m.Enqueue(StartRequest{Title: "a", Kind: "general", Brief: "read", Model: "openrouter:" + orGLM,
+			MaxBudgetUSD: 1, Sources: []string{src}})
+		return err
+	}
+	if err := start(secret); err == nil || !strings.Contains(err.Error(), "denied to openrouter jobs") {
+		t.Fatalf("file in a denied repo: %v", err)
+	}
+	// The same file is fine for a claude job.
+	if _, err := m.Enqueue(StartRequest{Title: "c", Kind: "general", Brief: "read", Model: "sonnet", Sources: []string{secret}}); err != nil {
+		t.Fatalf("claude job with the same source: %v", err)
+	}
+	if err := start(outside); err != nil {
+		t.Fatalf("file outside the denied repo: %v", err)
+	}
+	if err := m.Store.Insert(&store.Job{ID: "priv", Agent: m.Agent, Title: "p", Kind: "general", RepoPath: denied,
+		Status: store.StatusSucceeded}); err != nil {
+		t.Fatal(err)
+	}
+	if err := start("job:priv"); err == nil || !strings.Contains(err.Error(), "denied to openrouter jobs") {
+		t.Fatalf("report of a job on a denied repo: %v", err)
+	}
+}
