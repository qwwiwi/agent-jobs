diff --git a/internal/jobs/git_timeout_test.go b/internal/jobs/git_timeout_test.go
index 014ee40..0232eb3 100644
--- a/internal/jobs/git_timeout_test.go
+++ b/internal/jobs/git_timeout_test.go
@@ -287,6 +287,53 @@ exec '`+real+`' "$@"
 	}
 }
 
+// The judge tree's git cat-file hands its stdout to the caller as a file the caller reads itself, so
+// the runner does not copy it (#114): a git that exits at once while a process of its group still
+// holds that stdout does not leave the process running past the deadline. The tracked stream keeps
+// git's PID, the group's ID, reserved, so the kill at the deadline still reaches the holder, and the
+// call is errGitTimeout.
+func TestMaterializeTreeTimeoutKillsCatFileChild(t *testing.T) {
+	repo, sha := gateRepo(t)
+	real, err := exec.LookPath("git")
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := t.TempDir()
+	t.Setenv("FAKE_GIT_STATE", state)
+	// cat-file --batch starts sleep 60 with the inherited stdout, records its pid and exits at once:
+	// the caller's read then blocks on the pipe only the child holds. Every other git call is the real
+	// one, also the ls-tree of the judge tree that runs first.
+	fakeGitOnPath(t, `for a in "$@"; do [ "$a" = cat-file ] && { sleep 60 & echo $! > "$FAKE_GIT_STATE/child"; exit 0; }; done
+exec '`+real+`' "$@"
+`)
+	// A deadline wide enough for the real ls-tree on a busy host, and a wait delay past it, so that the
+	// kill comes from the deadline, not from the reaper's own delay (TestGitTimeoutKillsChildAfterGitExit).
+	shortGitLongTimeout(t, time.Second)
+	origDelay := gitWaitDelay
+	gitWaitDelay = 30 * time.Second
+	t.Cleanup(func() { gitWaitDelay = origDelay })
+	err = returnsWithin(t, 30*time.Second, "materializeTree", func() error {
+		return materializeTree(repo, sha, t.TempDir(), nil)
+	})
+	if !errors.Is(err, errGitTimeout) {
+		t.Fatalf("want errGitTimeout, got %v", err)
+	}
+	b, err := os.ReadFile(filepath.Join(state, "child"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	pid, err := strconv.Atoi(strings.TrimSpace(string(b)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = syscall.Kill(pid, syscall.SIGKILL) }()
+	for deadline := time.Now().Add(5 * time.Second); !processGone(t, pid); time.Sleep(50 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			t.Fatalf("cat-file's child %d still runs after the deadline: git's group was not killed", pid)
+		}
+	}
+}
