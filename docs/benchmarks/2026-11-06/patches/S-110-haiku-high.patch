+// ownedHelperArg is the test selector that makes the test binary run only TestOwnedHelperDaemon.
+const ownedHelperArg = "-test.run=^TestOwnedHelperDaemon$"
+
+// startedDaemonCase runs one #105 case on t: a helper test starts a daemon, then fails mid-way or hangs
+// before its own kill, and the daemon must be gone when the case ends. pidWait bounds the wait for the
+// daemon's pid in pidFile.
+func startedDaemonCase(t testing.TB, mode, pidFile string, pidWait time.Duration) {
+	t.Helper()
+	c := exec.Command(os.Args[0], ownedHelperArg, "-test.count=1")
+	c.Env = append(os.Environ(), ownedHelperEnv+"="+selfBin, ownedHelperPIDFile+"="+pidFile, ownedHelperMode+"="+mode)
+	c.Stdout, c.Stderr = io.Discard, io.Discard
+	if err := c.Start(); err != nil {
+		t.Fatal(err)
+	}
+	// The only Wait of c runs in its goroutine, which closes exited. The cleanup is registered before
+	// any wait, so a failing pid wait below cannot leave the helper and its daemon running (#110).
+	exited := make(chan struct{})
+	var waitErr error
+	go func() {
+		waitErr = c.Wait()
+		close(exited)
+	}()
+	t.Cleanup(func() {
+		_ = c.Process.Kill() // harmless error when c has already exited
+		<-exited
+	})
+	var pid int
+	var home string
+	waitFor(t, "daemon pid", pidWait, func() bool {
+		b, err := os.ReadFile(pidFile)
+		f := strings.Split(string(b), "\n")
+		if err != nil || len(f) < 2 {
+			return false
+		}
+		pid, _ = strconv.Atoi(f[0])
+		home = f[1]
+		return pid > 0
+	})
+	t.Cleanup(func() {
+		if alive(pid) && procHasArg(pid, "daemon") {
+			_ = syscall.Kill(pid, syscall.SIGKILL)
+		}
+		if home != "" && mode == "hang" {
+			_ = os.RemoveAll(home) // the killed helper ran no cleanup of its own
+		}
+	})
+	if mode == "hang" {
+		_ = c.Process.Kill()
+	}
+	select {
+	case <-exited:
+		if waitErr == nil {
+			t.Fatal("the helper test passed; it must fail mid-way")
+		}
+	case <-time.After(30 * time.Second):
+		t.Fatal("helper test did not end") // the helper's cleanup kills it
+	}
+	waitFor(t, "daemon gone", 5*time.Second, func() bool { return !alive(pid) || !procHasArg(pid, "daemon") })
+}
+
+// #110: when the wait for the daemon's pid fails, the case must still end its helper. The failing case
+// runs on a failTB, so the test runs the cleanups itself and then looks at the helper process.
+func TestStartedHelperIsEndedWhenPIDWaitFails(t *testing.T) {
+	pidFile := filepath.Join(t.TempDir(), "daemon.pid")
+	fake := &failTB{TB: t}
+	ran := make(chan struct{})
+	go func() {
+		defer close(ran)
+		startedDaemonCase(fake, "silent", pidFile, 300*time.Millisecond)
+	}()
+	<-ran
+	if !fake.failed {
+		t.Fatal("the daemon pid wait did not fail; the case did not reach the path under test")
+	}
+	var helper int
+	waitFor(t, "helper pid", 30*time.Second, func() bool {
+		b, err := os.ReadFile(pidFile)
+		helper, _ = strconv.Atoi(string(b))
+		return err == nil && helper > 0
+	})
+	t.Cleanup(func() { // safety net: a leaked helper would sleep for two minutes
+		if alive(helper) && procHasArg(helper, ownedHelperArg) {
+			_ = syscall.Kill(helper, syscall.SIGKILL)
+		}
+	})
+	for i := len(fake.cleanups) - 1; i >= 0; i-- {
+		fake.cleanups[i]()
+	}
+	waitFor(t, "helper gone", 5*time.Second, func() bool { return !alive(helper) || !procHasArg(helper, ownedHelperArg) })
+}
+
+// failTB is a testing.TB for a case expected to fail: Fatal ends the calling goroutine instead of the
+// test, and Cleanup records the functions so the test can run them.
+type failTB struct {
+	testing.TB
+	failed   bool
+	cleanups []func()
+}
+
+func (f *failTB) Fatal(...any) {
+	f.failed = true
+	runtime.Goexit()
+}
+
+func (f *failTB) Fatalf(string, ...any) {
+	f.failed = true
+	runtime.Goexit()
+}
+
+func (f *failTB) Cleanup(fn func()) {
+	f.cleanups = append(f.cleanups, fn)
+}
