+++ b/internal/jobs/gaterunner_test.go
@@ -0,0 +1,291 @@
+package jobs
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/qwwiwi/agent-jobs/internal/store"
+	"github.com/qwwiwi/agent-jobs/internal/testutil"
+)
+
+// gateJobDir is a job dir with a work dir below a state dir of its own agent-jobs home, so the box
+// gate lock of its gates is that home's gate.lock and no other test's gates contend for it.
+func gateJobDir(t *testing.T) string {
+	t.Helper()
+	jobDir := filepath.Join(testutil.ShortTempDir(t), "test", "jobs", "j1")
+	if err := os.MkdirAll(filepath.Join(jobDir, "work"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	return jobDir
+}
+
+// One gate at a time per box (#134): a second gate that starts while a first one holds the box gate
+// lock waits for it; its command runs only after the first gate's command ended. Before the lock the
+// two ran concurrently (OOM on a busy box).
+func TestGateLockOneAtATime(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("the order file timestamps need GNU date")
+	}
+	jobDir := gateJobDir(t)
+	work := filepath.Join(jobDir, "work")
+	home := filepath.Dir(filepath.Dir(filepath.Dir(jobDir)))
+	order := filepath.Join(home, "order.txt")
+	logf, err := os.Create(filepath.Join(home, "wrapper.log"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer logf.Close()
+	line := func(name string) string {
+		return fmt.Sprintf("echo %s $(date +%%s%%N) >> %q", name, order)
+	}
+	run := func(cmd string) chan int {
+		done := make(chan int, 1)
+		go func() {
+			done <- runShellGroup(context.Background(), jobDir, work, nil, cmd, time.Minute, io.Discard, logf, nil)
+		}()
+		return done
+	}
+	doneA := run(line("A-start") + "; sleep 1; " + line("A-end"))
+	waitFor(t, "the first gate to start", 10*time.Second, func() bool {
+		b, err := os.ReadFile(order)
+		return err == nil && strings.Contains(string(b), "A-start")
+	})
+	// The second gate starts while the first one holds the lock (A-start is in the order file, A-end
+	// is not yet) and must wait for it.
+	doneB := run(line("B-start") + "; sleep 0.1; " + line("B-end"))
+	for _, done := range []chan int{doneA, doneB} {
+		select {
+		case <-done:
+		case <-time.After(30 * time.Second):
+			t.Fatal("a gate did not end")
+		}
+	}
+	times := map[string]int64{}
+	for _, l := range strings.Split(readFile(t, order), "\n") {
+		name, ns, ok := strings.Cut(strings.TrimSpace(l), " ")
+		if ok {
+			times[name], _ = strconv.ParseInt(ns, 10, 64)
+		}
+	}
+	if len(times) != 4 {
+		t.Fatalf("order file:\n%s", readFile(t, order))
+	}
+	if times["B-start"] < times["A-end"] {
+		t.Fatalf("the second gate's command ran before the first gate's ended (B-start %d < A-end %d)",
+			times["B-start"], times["A-end"])
+	}
+	if log := readAll(t, logf); !strings.Contains(log, "waiting for the box gate lock") {
+		t.Fatalf("the waiting gate never said so:\n%s", log)
+	}
+}
+
+// A gate that cannot take the box gate lock within its own timeout fails as a timeout instead of
+// running alongside the holder or hanging on it (#134: no hung waiters).
+func TestGateLockWaitIsBoundedByTheTimeout(t *testing.T) {
+	jobDir := gateJobDir(t)
+	work := filepath.Join(jobDir, "work")
+	home := filepath.Dir(filepath.Dir(filepath.Dir(jobDir)))
+	ranA, ranB := filepath.Join(home, "a-ran"), filepath.Join(home, "b-ran")
+	logf, err := os.Create(filepath.Join(home, "wrapper.log"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer logf.Close()
+	holder := make(chan int, 1)
+	go func() {
+		holder <- runShellGroup(context.Background(), jobDir, work, nil, "touch "+ranA+"; sleep 1", time.Minute, io.Discard, logf, nil)
+	}()
+	waitFor(t, "the holder to start", 10*time.Second, func() bool {
+		_, err := os.Stat(ranA)
+		return err == nil
+	})
+	start := time.Now()
+	exit := runShellGroup(context.Background(), jobDir, work, nil, "touch "+ranB, 300*time.Millisecond, io.Discard, logf, nil)
+	if exit != store.AcceptanceTimedOut {
+		t.Fatalf("exit %d, want the timeout (%d)", exit, store.AcceptanceTimedOut)
+	}
+	if took := time.Since(start); took > 5*time.Second {
+		t.Fatalf("the waiter hung for %s", took)
+	}
+	if _, err := os.Stat(ranB); err == nil {
+		t.Fatal("a gate ran while another one held the box gate lock")
+	}
+	if log := readAll(t, logf); !strings.Contains(log, "box gate lock") || !strings.Contains(log, "did not free in time") {
+		t.Fatalf("the timed-out waiter never said why:\n%s", log)
+	}
+	select {
+	case <-holder:
+	case <-time.After(30 * time.Second):
+		t.Fatal("the holder never ended")
+	}
+}
+
+// The exit marker line always carries exit= (#134): a gate that ends, however it ends, leaves this
+// line in the wrapper's log.
+func TestGateExitMarkerAlwaysPrinted(t *testing.T) {
+	for _, c := range []struct {
+		step string
+		exit int
+		dur  time.Duration
+		head string
+		note string
+		want string
+	}{
+		{"acceptance", 0, 3 * time.Second, "0123456789abcdef0123", "", "run-wrapper: acceptance exit=0 head=0123456789ab after 3s"},
+		{"prepare", 3, 3200 * time.Millisecond, "", "", "run-wrapper: prepare exit=3 after 3s"},
+		{"manifest-check", 0, 15 * time.Second, "fedcba9876543210fedcba", "", "run-wrapper: manifest-check exit=0 head=fedcba987654 after 15s"},
+		{"acceptance", store.AcceptanceTimedOut, 15 * time.Minute, "", "", "run-wrapper: acceptance exit=-1 (timeout) after 15m0s"},
+		{"acceptance", acceptanceSignalled, 2 * time.Second, "", "", "run-wrapper: acceptance exit=-2 (stopped by a signal) after 2s"},
+		{"acceptance", gateNotRunExit, 0, "abcdefabcdef", "not run: HEAD abcdef does not descend from the job's base",
+			"run-wrapper: acceptance exit=125 head=abcdefabcdef (not run: HEAD abcdef does not descend from the job's base) after 0s"},
+	} {
+		var b bytes.Buffer
+		gateExitMarker(&b, c.step, c.exit, c.dur, c.head, c.note)
+		if got := b.String(); got != c.want+"\n" {
+			t.Errorf("marker(%s, %d, %s, %q, %q) = %q, want %q", c.step, c.exit, c.dur, c.head, c.note, got, c.want+"\n")
+		}
+		if !strings.Contains(b.String(), "exit=") {
+			t.Errorf("marker without exit=: %q", b.String())
+		}
+	}
+}
+
+// The head assert (#134): a job without a repository has nothing to assert; one with a repository but
+// without its work dir is refused.
+func TestAssertGateHead(t *testing.T) {
+	head, why := assertGateHead(t.TempDir(), &store.Job{})
+	if head != "" || why != "" {
+		t.Fatalf("no repository: head %q why %q", head, why)
+	}
+	repo := newRepo(t)
+	base := gitT(t, repo, "rev-parse", "HEAD")
+	head, why = assertGateHead(filepath.Join(t.TempDir(), "j"), &store.Job{RepoPath: repo, BaseCommit: base})
+	if head != "" || why == "" || !strings.Contains(why, "work dir") {
+		t.Fatalf("missing work dir: head %q why %q", head, why)
+	}
+}
+
+// The gate runs at the job's own head: a repo job whose runner committed passes its acceptance
+// command, and the marker line names the head it ran at.
+func TestAcceptanceGateRunsAtTheJobsHead(t *testing.T) {
+	m := acceptanceManager(t, "")
+	repo := newRepo(t)
+	j := enqueue(t, m, "FAKE_ONLY_COMMIT", func(r *StartRequest) {
+		r.Kind = "fix"
+		r.RepoPath = repo
+		r.AcceptanceCmd = `echo GATE_OK; touch ../acc-ran`
+	})
+	j = runToEnd(t, m, j.ID)
+	if j.Status != store.StatusSucceeded || j.Error != "" {
+		t.Fatalf("got %s err=%q", j.Status, j.Error)
+	}
+	dir := m.JobDir(j.ID)
+	if _, err := os.Stat(filepath.Join(dir, "acc-ran")); err != nil {
+		t.Fatalf("the acceptance command did not run: %v", err)
+	}
+	if log := readFile(t, filepath.Join(dir, "stderr.log")); !strings.Contains(log, "run-wrapper: acceptance exit=0 head=") {
+		t.Fatalf("no exit marker with the head in stderr.log:\n%s", log)
+	}
+}
+
+// A gate on the wrong HEAD is refused (#134): a runner that left the worktree at a commit that does
+// not descend from the job's base cannot have its acceptance command pass on code that is not the
+// job's. The command does not run, nothing is recorded and the job fails as an acceptance that did
+// not run, with the reason in the marker line.
+func TestAcceptanceWrongHeadRefused(t *testing.T) {
+	m := acceptanceManager(t, "")
+	repo := newRepo(t)
+	// An unrelated root commit (same tree, no parent): not in the job's chain.
+	tree := gitT(t, repo, "rev-parse", "HEAD^{tree}")
+	sha := gitT(t, repo, "commit-tree", tree, "-m", "unrelated")
+	j := enqueue(t, m, "FAKE_DETACH "+sha, func(r *StartRequest) {
+		r.Kind = "fix"
+		r.RepoPath = repo
+		r.AcceptanceCmd = `touch ../acc-ran`
+	})
+	j = runToEnd(t, m, j.ID)
+	if j.Status != store.StatusFailed || !strings.HasPrefix(j.Error, "acceptance did not run") {
+		t.Fatalf("got %s err=%q", j.Status, j.Error)
+	}
+	if j.AcceptanceExit != nil || j.AcceptanceStartedAt != nil {
+		t.Fatalf("a refused gate recorded a result: %+v", j)
+	}
+	dir := m.JobDir(j.ID)
+	if _, err := os.Stat(filepath.Join(dir, "acc-ran")); err == nil {
+		t.Fatal("the acceptance command ran on the wrong head")
+	}
+	log := readFile(t, filepath.Join(dir, "stderr.log"))
+	if !strings.Contains(log, "exit=125") || !strings.Contains(log, "does not descend from the job's base") {
+		t.Fatalf("the refusal marker line is missing its exit or its reason:\n%s", log)
+	}
+}
+
+// A prepare step keeps the runner's environment but never the Telegram gateway's variables (#134):
+// what the command starts (a postinstall script of an installed package) cannot read them.
+func TestPrepareEnvDropsTelegram(t *testing.T) {
+	m := newManager(t)
+	repo := newRepo(t)
+	t.Setenv("TELEGRAM_BOT_TOKEN", "12345:TESTTOKEN")
+	t.Setenv("TELEGRAM_PROXY_URL", "http://example.invalid")
+	t.Setenv("PREPARE_KEEP_VAR", "kept")
+	withPrepareConfig(t, m, []PrepareStep{{RepoGlob: filepath.Base(repo), Command: "env > ../prep-env.txt"}}, "")
+	j := runToEnd(t, m, enqueue(t, m, "do it", inRepo(repo)).ID)
+	if j.Status != store.StatusSucceeded || j.Error != "" {
+		t.Fatalf("got %s err=%q", j.Status, j.Error)
+	}
+	env := readFile(t, filepath.Join(m.JobDir(j.ID), "prep-env.txt"))
+	if strings.Contains(env, "TELEGRAM_") || strings.Contains(env, "12345:TESTTOKEN") {
+		t.Fatalf("the prepare env carried the Telegram gateway's variables:\n%s", env)
+	}
+	if !strings.Contains(env, "PREPARE_KEEP_VAR=kept") {
+		t.Fatalf("the prepare env dropped a variable it must keep:\n%s", env)
+	}
+}
+
+// On its timeout the gate's whole process group is ended (#134): a child that ignores SIGTERM (an
+// orphaned suite) does not outlive the gate.
+func TestGateTimeoutKillsProcessGroup(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("the leftover check reads /proc (Linux)")
+	}
+	old := acceptanceKillGrace
+	acceptanceKillGrace = 300 * time.Millisecond
+	t.Cleanup(func() { acceptanceKillGrace = old })
+	jobDir := gateJobDir(t)
+	work := filepath.Join(jobDir, "work")
+	var log bytes.Buffer
+	exit := runShellGroup(context.Background(), jobDir, work, nil,
+		`sh -c 'trap "" TERM; sleep 60' & echo $! > ../child.pid; sleep 60`, 300*time.Millisecond, io.Discard, &log, nil)
+	if exit != store.AcceptanceTimedOut {
+		t.Fatalf("exit %d, want the timeout (%d)", exit, store.AcceptanceTimedOut)
+	}
+	var pid int
+	if _, err := fmt.Sscan(readFile(t, filepath.Join(jobDir, "child.pid")), &pid); err != nil || pid <= 1 {
+		t.Fatalf("child pid: %d %v", pid, err)
+	}
+	t.Cleanup(func() { _ = syscall.Kill(-pid, syscall.SIGKILL) })
+	waitFor(t, "the TERM-ignoring child to be killed", 5*time.Second, func() bool { return !procAlive(pid) })
+}
+
+// readAll reads a log file the gates still write to.
+func readAll(t *testing.T, f *os.File) string {
+	t.Helper()
+	if _, err := f.Seek(0, io.SeekStart); err != nil {
+		t.Fatal(err)
+	}
+	b, err := io.ReadAll(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
