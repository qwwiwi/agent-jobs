diff --git a/internal/jobs/gaterunner.go b/internal/jobs/gaterunner.go
new file mode 100644
index 0000000..f348f72
--- /dev/null
+++ b/internal/jobs/gaterunner.go
@@ -0,0 +1,176 @@
+package jobs
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/qwwiwi/agent-jobs/internal/store"
+)
+
+// The gate runner (issue #134): the wrapper's heavy local gates — a job's acceptance command (a
+// check.sh, a pg suite), the judge's manifest-check step and the prepare step (an install, a vite
+// build) — all run through runShellGroup, and four rules hold for every one of them:
+//
+//   - One gate at a time per box: a flock at the agent-jobs home (the state dir's parent, shared by
+//     every agent on the box) serializes them, so concurrent jobs never run two heavy gates at once
+//     (OOM). Waiting for the lock shares the gate's own time budget, so a queued gate either starts
+//     within its timeout or fails as a timeout: it never hangs and never overruns the deadline the
+//     wrapper recorded for it.
+//   - Assert HEAD: the acceptance command runs in the job's worktree only after the wrapper proved
+//     the worktree is the job's own (verifyWorktreeAt) and its HEAD descends from the job's base
+//     commit, so a runner that left HEAD somewhere else (it checked out an unrelated commit) cannot
+//     have its gate pass on code that is not the job's.
+//   - Always print exit=: every path that ends a gate prints one marker line with exit= (and the head
+//     it ran at, and how long it took), also when it timed out, was stopped by a signal or was
+//     refused before it started: no gate ends silently, no waiter hangs on a gate that is over.
+//   - Clean env: the prepare step keeps the runner's environment (the real HOME, the package
+//     stores) but never the Telegram gateway's TELEGRAM_* variables; the acceptance and
+//     manifest-check environments are allow-listed (acceptanceEnvKeys) and never carried them.
+
+// gateNotRunExit marks a gate that was refused before its command started (the head assert failed):
+// the job fails as an acceptance that did not run, with this exit and the reason in the marker line.
+const gateNotRunExit = 125
+
+// gateLockName is the box gate lock file's name, in the agent-jobs home (the state dir's parent,
+// shared by every agent on the box) or, when no lock file can be created there, in the state dir
+// itself (per agent: the gate still cannot overlap within one agent's jobs).
+const gateLockName = "gate.lock"
+
+// gateLockPoll is how often the box gate lock is retried while another gate holds it, the polled
+// LOCK_NB pattern of tmux.lock: a holder that dies releases the lock through the kernel (its file
+// descriptor closes), so no gate waits on a stale one.
+const gateLockPoll = 50 * time.Millisecond
+
+// gateLockPaths are where the box gate lock of a job of jobDir (<state>/jobs/<id>) lives: the
+// agent-jobs home first, the state dir as the fallback. Both may be unusable (an unwritable home on
+// an unusual install): the gate then runs without the box gate lock, and the wrapper's log says so.
+func gateLockPaths(jobDir string) []string {
+	abs, err := filepath.Abs(jobDir)
+	if err != nil {
+		return nil
+	}
+	state := filepath.Dir(filepath.Dir(abs))
+	return []string{filepath.Join(filepath.Dir(state), gateLockName), filepath.Join(state, gateLockName)}
+}
+
+// acquireGateLock takes the box gate lock for a gate of jobDir, polling until it gets it or ctx ends.
+// It returns the release func, or nil when it does not hold the lock: then ctx ended (the caller
+// fails the gate: parent ended or the timeout ran out while waiting) or no lock file could be opened
+// (logged; the caller runs the gate without the box gate lock rather than not at all).
+func acquireGateLock(ctx context.Context, jobDir string, log io.Writer) func() {
+	for _, path := range gateLockPaths(jobDir) {
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600)
+		if err != nil {
+			continue
+		}
+		waited := false
+		for {
+			err = syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+			if err == nil {
+				return func() {
+					_ = syscall.Flock(int(f.Fd()), syscall.LOCK_UN)
+					_ = f.Close()
+				}
+			}
+			if !errors.Is(err, syscall.EWOULDBLOCK) && !errors.Is(err, syscall.EINTR) {
+				_ = f.Close()
+				break // try the fallback path
+			}
+			if !waited {
+				waited = true
+				fmt.Fprintf(log, "run-wrapper: gate: waiting for the box gate lock %s\n", path)
+			}
+			select {
+			case <-ctx.Done():
+				fmt.Fprintf(log, "run-wrapper: gate: the box gate lock %s did not free in time; the command is not run\n", path)
+				_ = f.Close()
+				return nil
+			case <-time.After(gateLockPoll):
+			}
+		}
+	}
+	fmt.Fprintln(log, "run-wrapper: gate: no gate lock file could be opened; running without the box gate lock")
+	return nil
+}
+
+// assertGateHead is the acceptance command's head assert: work below jobDir must be the job's own
+// verified worktree whose HEAD descends from the job's base commit, so the gate runs on the job's own
+// code and never on whatever else a runner left checked out. It returns the HEAD commit ("" for a job
+// without a repository, and set when known even on refusal, for the exit marker) and why the gate
+// must not run ("" = it must run).
+func assertGateHead(jobDir string, j *store.Job) (head, why string) {
+	if j.RepoPath == "" || j.BaseCommit == "" {
+		return "", ""
+	}
+	work := filepath.Join(jobDir, "work")
+	if fi, err := os.Lstat(work); err != nil || !fi.IsDir() {
+		return "", "the job's work dir is not there any more"
+	}
+	if err := verifyWorktreeAt(jobDir, j, work); err != nil {
+		return "", "the job's worktree is not verified: " + RedactPrintable(err.Error(), 160)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), MergeCheckTimeout)
+	defer cancel()
+	head, err := gitCtxOK(ctx, work, "rev-parse", "--verify", "HEAD^{commit}")
+	if err != nil {
+		return "", "HEAD of the job's worktree is not a commit: " + RedactPrintable(err.Error(), 160)
+	}
+	// merge-base --is-ancestor exits 1 when HEAD is not a descendant of the base: the runner left the
+	// worktree at a commit of its own choosing, and the gate would pass or fail on code that is not
+	// the job's.
+	_, code, _, err := gitCtx(ctx, work, "merge-base", "--is-ancestor", j.BaseCommit, head)
+	switch {
+	case err != nil:
+		return head, "the worktree HEAD could not be checked against the job's base: " + RedactPrintable(err.Error(), 160)
+	case code != 0:
+		return head, fmt.Sprintf("HEAD %s does not descend from the job's base %s: the gate would not run on the job's own code",
+			shortSHA(head), shortSHA(j.BaseCommit))
+	}
+	return head, ""
+}
+
+// gateExitMarker is the line that ends every gate run in the wrapper's log: the step, the exit code
+// (always printed, with exit=, whatever ended the gate), the head it ran at, how long it took and, on
+// a refusal, why it did not run. A reader of stderr.log always finds this line: no gate ends
+// silently, no waiter hangs on a gate that is already over.
+func gateExitMarker(log io.Writer, step string, exit int, dur time.Duration, head, note string) {
+	if note == "" {
+		switch exit {
+		case store.AcceptanceTimedOut:
+			note = "timeout"
+		case acceptanceSignalled:
+			note = "stopped by a signal"
+		}
+	}
+	line := fmt.Sprintf("run-wrapper: %s exit=%d", step, exit)
+	if head != "" {
+		line += " head=" + shortSHA(head)
+	}
+	if note != "" {
+		line += " (" + RedactPrintable(note, 200) + ")"
+	}
+	fmt.Fprintf(log, "%s after %s\n", line, dur.Round(time.Second))
+}
+
+// gateEnvDropPrefixes are dropped from the environment of a gate that keeps the runner's environment
+// (the prepare step: it needs the real HOME, the package stores and caches): the Telegram gateway's
+// variables must not reach a command the repository's own scripts (a postinstall hook) can read. The
+// acceptance and manifest-check environments are allow-listed (acceptanceEnvKeys) and never carried
+// them.
+var gateEnvDropPrefixes = []string{"TELEGRAM_"}
+
+// dropGateEnv drops every variable whose name starts with one of gateEnvDropPrefixes from env.
+func dropGateEnv(env []string) []string {
+	return slices.DeleteFunc(env, func(kv string) bool {
+		k, _, _ := strings.Cut(kv, "=")
+		return slices.ContainsFunc(gateEnvDropPrefixes, func(p string) bool { return strings.HasPrefix(k, p) })
+	})
+}
