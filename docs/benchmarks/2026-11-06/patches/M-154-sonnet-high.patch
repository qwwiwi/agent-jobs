+// `result`. The later event normally replaces the earlier one, but when the earlier one holds the report
+// and the later one does not, the report text stays: the trailing notification turn must not empty
+// report.md or fail the report contract. Then the run's turns are the sum of both events' turns (each
+// counts its own) and the cost the larger figure (the session total, which the later event includes).
+func mergeResult(prev, next StreamResult) StreamResult {
+	if !prev.Found || !isReport(prev.Text) || isReport(next.Text) {
+		return next
+	}
+	next.Text = prev.Text
+	next.Turns += prev.Turns
+	next.CostUSD = max(next.CostUSD, prev.CostUSD)
+	return next
+}
