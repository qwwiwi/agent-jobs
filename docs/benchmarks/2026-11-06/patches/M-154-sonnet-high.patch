+package jobs
+
+import (
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+const trailingReport = "## Summary\ndone\n\n## Findings / Changes\nx\n\n## Evidence\ny\n\n## Not done / uncertain\nnothing\n\n## Progress\n- ok\n"
+
+// twoResultStream is a claude stream whose session wrote its report in the first result and was woken
+// by a background-task notification for a second, one-turn result (#154).
+func twoResultStream(t *testing.T, second string) string {
+	t.Helper()
+	line := func(m map[string]any) string {
+		b, err := json.Marshal(m)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return string(b) + "\n"
+	}
+	return line(map[string]any{"type": "result", "subtype": "success", "num_turns": 87, "total_cost_usd": 1.5, "result": trailingReport}) +
+		line(map[string]any{"type": "result", "subtype": "success", "num_turns": 1, "total_cost_usd": 1.6, "result": second})
+}
+
+const trailingNotification = "Это уведомление от моего же таймера ожидания; работа завершена."
+
+// The report comes from the last result that has the report sections; turns add up and the cost is the
+// session's total, so a trailing notification turn neither empties report.md nor fails the contract.
+func TestTeeKeepsReportOverTrailingNotificationResult(t *testing.T) {
+	tee := &resultTee{w: io.Discard}
+	_, _ = tee.Write([]byte(twoResultStream(t, trailingNotification)))
+	tee.end()
+	r := tee.res
+	if r.Text != trailingReport {
+		t.Fatalf("report text lost: %q", r.Text)
+	}
+	if r.Turns != 88 || r.CostUSD != 1.6 || r.Results != 2 || !r.Found || r.IsError || r.Subtype != "success" {
+		t.Fatalf("totals: %+v", r)
+	}
+	if n := reportContractNote(r.Text, nil); n != "" {
+		t.Fatalf("contract note %q", n)
+	}
+}
+
+// ParseStream (stream.jsonl read back) merges the same way.
+func TestParseStreamKeepsReportOverTrailingNotificationResult(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "stream.jsonl")
+	if err := os.WriteFile(p, []byte(twoResultStream(t, trailingNotification)), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	r := ParseStream(p)
+	if r.Text != trailingReport || r.Turns != 88 || r.CostUSD != 1.6 {
+		t.Fatalf("parse: %+v", r)
+	}
+}
+
+// When the later result is a report too, it wins; when neither is, the last one stays as before.
+func TestTrailingResultMergeRules(t *testing.T) {
+	later := "## Summary\nnewer\n\n## Not done / uncertain\nnothing\n"
+	tee := &resultTee{w: io.Discard}
+	_, _ = tee.Write([]byte(twoResultStream(t, later)))
+	tee.end()
+	if tee.res.Text != later {
+		t.Fatalf("later report must win: %q", tee.res.Text)
+	}
+	tee = &resultTee{w: io.Discard}
+	_, _ = tee.Write([]byte(claudeResultLine(t, "no report a") + claudeResultLine(t, "no report b")))
+	tee.end()
+	if tee.res.Text != "no report b" {
+		t.Fatalf("last non-report result must stay: %q", tee.res.Text)
+	}
+}
