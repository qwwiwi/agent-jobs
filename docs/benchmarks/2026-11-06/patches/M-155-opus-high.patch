@@ -0,0 +1,119 @@
+package guard
+
+import "testing"
+
+// Issue #155: remote rsync still got past the guard after #116 through a literal `+` inside a
+// find -exec argv, inline interpreter code and a dynamic operand; a local rsync with a
+// --log-file-format value or a `-f'- *.cache'` filter was falsely refused; and a double nesting
+// (find -exec parallel rsync|ssh) hid the remote argument in parallel's input.
+func TestRsyncBypasses155(t *testing.T) {
+	t.Setenv("HOME", "/home/u")
+	t.Setenv("CDPATH", "")
+	cfg := Config{Dir: "/home/u/work"}
+	cases := []struct {
+		name  string
+		cmd   string
+		block bool
+	}{
+		// High: a `+` that is an option value, not find's terminator.
+		{"find -exec rsync --exclude +", `find . -maxdepth 0 -exec rsync --exclude + ./src/ host:/dst/ \;`, true},
+		{"find -exec rsync + operand", `find . -exec rsync + ./src/ host:/dst/ \;`, true},
+		{"find -exec rsync plus terminator remote", `find . -exec rsync a host:/b {} +`, true},
+		{"find -exec rsync then printf", `find . -exec rsync a b \; -printf '%p:%y\n'`, false},
+		// High: rsync inside inline interpreter code.
+		{"python -c os.system rsync", `python3 -c 'import os; os.system("rsync ./src/ host:/dst/")'`, true},
+		{"python -c subprocess rsync", `python3 -c 'import subprocess; subprocess.run(["rsync", "a", "h:/b"])'`, true},
+		{"perl -e rsync", `perl -e 'system("rsync a h:/b")'`, true},
+		{"node -e rsync", `node -e 'require("child_process").execSync("rsync a h:/b")'`, true},
+		{"setsid sh-less watch rsync", `watch 'rsync a h:/b'`, true},
+		{"python -c plain", `python3 -c 'print(1)'`, false},
+		{"python -c word rsync_x", `python3 -c 'print("rsyncd.conf")'`, false},
+		// High: a dynamic operand.
+		{"setsid rsync $DST", `DST=host:/dst/; setsid rsync ./src/ "$DST"`, true},
+		{"rsync $DST", `DST=host:/dst/; rsync ./src/ "$DST"`, true},
+		{"rsync subst operand", `rsync ./src/ "$(echo host:/dst/)"`, true},
+		{"find -exec rsync $DST", `find . -exec rsync ./src/ "$DST" \;`, true},
+		{"rsync dynamic -e value", `rsync "$OPT" ./src/ ./dst/`, true},
+		{"rsync local literal", `setsid rsync ./src/ ./dst/`, false},
+		{"rsync dynamic exclude value", `rsync --exclude "$PAT" ./src/ ./dst/`, false},
+		// Medium: option values that are data.
+		{"rsync --log-file-format", `rsync --log-file-format '%f:%l' ./src/ ./dst/`, false},
+		{"rsync -f glob filter", `rsync -f'- *.cache' ./src/ ./dst/`, false},
+		{"rsync --exclude glob", `rsync --exclude '*.cache' ./src/ ./dst/`, false},
+		{"rsync unquoted glob exclude refused", `rsync --exclude *.cache ./src/ ./dst/`, true},
+		{"rsync bare $PAT exclude refused", `rsync --exclude $PAT ./src/ ./dst/`, true},
+		{"find -exec setsid -f rsync remote", `find . -exec setsid -f rsync a h:/b \;`, true},
+		{"find -exec setsid ssh", `find . -exec setsid ssh h \;`, true},
+		{"setsid setsid rsync quoted ; hides nothing", `setsid setsid rsync a ';' h:/b`, true},
+		{"find -exec rsync {} + then -exec remote", `find . -exec rsync -a {} + -exec rsync a h:/b \;`, true},
+		{"sh -c local rsync stays allowed", `sh -c 'rsync -a ./src/ ./dst/'`, false},
+		{"bash -c remote rsync refused", `bash -c 'rsync a h:/b'`, true},
+		{"rsync glob operand still refused", `rsync ./src/* ./dst/`, true},
+		// Review follow-ups: tilde operands from a variable, code without spaces, filter values.
+		{"rsync ~/ with HOME set", `HOME=host:; rsync -a ./src/ ~/dst/`, true},
+		{"rsync ~- (OLDPWD)", `OLDPWD=host:/dst/; rsync -a ./src/ ~-`, true},
+		{"rsync ~+ (PWD)", `rsync -a ./src/ ~+/x`, true},
+		{"rsync ~/ plain HOME", `rsync -a ./src/ ~/dst/`, false},
+		{"perl -e code without spaces", `perl -e system+q+rsync+,q+./src/+,q+host:/dst/+`, true},
+		{"rsync own operand naming rsync", `rsync -a ./src/ "./rsync notes/"`, false},
+		{"rsync --out-format naming rsync", `rsync --out-format 'rsync: %n' ./src/ ./dst/`, false},
+		{"rsync --exclude .git", `rsync -a --exclude .git ./src/ ./dst/`, false},
+		{"rsync .git operand still refused", `rsync -a ./src/ .git`, true},
+		// Medium: double nesting, the remote argument from parallel's input.
+		{"find -exec parallel rsync", `find . -maxdepth 0 -exec parallel rsync ./src/ \;`, true},
+		{"setsid parallel rsync", `setsid parallel rsync ./src/`, true},
+		{"find -exec parallel ssh", `find . -maxdepth 0 -exec parallel ssh \;`, true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := Check(c.cmd, cfg)
+			if (got != "") != c.block {
+				t.Fatalf("Check(%q) = %q, want block=%v", c.cmd, got, c.block)
+			}
+		})
+	}
+}
+
+// findEnd stops at a `;` or at a `+` right after `{}`; any other `+` is an argument (#155).
+func TestFindEnd155(t *testing.T) {
+	cases := []struct {
+		action string
+		argv   []string
+		want   int
+	}{
+		{"-exec", []string{"rsync", "--exclude", "+", "a", "h:/b", ";"}, 5},
+		{"-exec", []string{"rsync", "-a", "{}", "+", "-printf", "x"}, 3},
+		{"-execdir", []string{"rsync", "-a", "{}", "+"}, 3},
+		{"-exec", []string{"rsync", "+", "a"}, 3},
+		{"-exec", []string{"+"}, 1},
+		{"-exec", []string{"{}", "+"}, 2},
+		// -ok/-okdir take no `+` form: find passes `{} +` on as arguments.
+		{"-ok", []string{"rsync", "-a", "{}", "+", "h:/b", ";"}, 5},
+		{"-okdir", []string{"rsync", "{}", "+"}, 3},
+	}
+	for _, c := range cases {
+		if got := findEnd(c.argv, c.action); got != c.want {
+			t.Errorf("findEnd(%q, %s) = %d, want %d", c.argv, c.action, got, c.want)
+		}
+	}
+}
+
+// execContext follows nested runners and ends a find action's command line at its terminator (#155).
+func TestExecContext155(t *testing.T) {
+	args := []string{".", "-exec", "parallel", "-j2", "rsync", "a", ";", "-printf", "%p:%y"}
+	runner, end := execContext("find", args)
+	if runner[4] != "parallel" || end[4] != 6 {
+		t.Errorf("rsync: runner %q end %d, want parallel 6", runner[4], end[4])
+	}
+	if runner[8] != "" || end[8] != len(args) {
+		t.Errorf("-printf value: runner %q end %d, want none %d", runner[8], end[8], len(args))
+	}
+	runner, _ = execContext("setsid", []string{"-f", "parallel", "rsync", "a"})
+	if runner[1] != "setsid" || runner[2] != "parallel" {
+		t.Errorf("setsid parallel rsync: runners %q", runner)
+	}
+	runner, _ = execContext("make", []string{"parallel", "rsync"})
+	if runner[0] != "" || runner[1] != "" {
+		t.Errorf("make targets are no command: runners %q", runner)
+	}
+}
