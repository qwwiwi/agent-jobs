 }
+
+// #146: deny_repos checks only the job's repository, so a file source (a path inside a denied repo, or
+// another job's report) would reach the third-party provider. An openrouter job takes no sources; the
+// same sources are fine on a claude job.
+func TestOpenRouterRefusesSources(t *testing.T) {
+	m := newManager(t)
+	m.Cfg.Providers.OpenRouter = orConfig(DefaultOpenRouterBaseURL, "/k")
+	denied := newRepo(t)
+	m.Cfg.Providers.OpenRouter.DenyRepos = []string{filepath.Base(denied)}
+	secret := sourceFixture(t, denied, "secret.md", "private repo content")
+	other := enqueue(t, m, "x", nil)
+	for name, src := range map[string]string{"file in a denied repo": secret, "job report": "job:" + other.ID} {
+		_, err := m.Enqueue(StartRequest{Title: "t", Kind: "general", Brief: "b", Model: "openrouter:" + orGLM,
+			Sources: []string{src}})
+		if err == nil || !strings.Contains(err.Error(), "sources") || !strings.Contains(err.Error(), "openrouter") {
+			t.Errorf("%s: want a sources refusal naming openrouter, got %v", name, err)
+		}
+	}
+	if spend, err := m.Store.ProviderSpendSince(m.Agent, store.ProviderOpenRouter, time.Now().Add(-time.Hour)); err != nil || spend != 0 {
+		t.Errorf("a refused job reserved $%.2f, %v", spend, err)
+	}
+	// The same file on a claude job is unchanged, and an openrouter job without sources still starts.
+	enqueue(t, m, "x", func(r *StartRequest) { r.Sources = []string{secret} })
+	enqueue(t, m, "x", func(r *StartRequest) { r.Model = "openrouter:" + orGLM; r.Sources = []string{} })
+}
