+// checkOpenRouterSources refuses file sources on an OpenRouter job (#146): a source file can come from
+// a denied repository or be another job's report, which deny_repos does not cover, and the job would
+// send it to a third-party provider. Allow them again only with a policy that checks each source.
+func checkOpenRouterSources(sources []string) error {
+	if len(sources) > 0 {
+		return fmt.Errorf("openrouter jobs take no sources (%d given): providers.openrouter.deny_repos does not cover "+
+			"source files, and the job would send them to a third-party provider; start the job without sources", len(sources))
+	}
+	return nil
+}
