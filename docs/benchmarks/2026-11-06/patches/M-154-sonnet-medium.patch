-// ParseStream returns the last `result` event in stream.jsonl (zero value if none).
+// mergeResult folds a later result event into an earlier one. A background task's notification can wake
+// the session for one more turn after the report was written, giving a second result event whose short
+// text is no report (#154): the earlier report text is kept, turns add up and the cost is the run total.
+// Status fields come from the later event.
+func mergeResult(prev, next StreamResult) StreamResult {
+	if !prev.Found || !isReport(prev.Text) || isReport(next.Text) {
+		return next
+	}
+	next.Text = prev.Text
+	next.Turns += prev.Turns
+	next.CostUSD = max(next.CostUSD, prev.CostUSD)
+	return next
+}
+
+// ParseStream returns the run's result from stream.jsonl (zero value if none): the last `result` event,
+// with the report of an earlier one when the last carries none (see mergeResult).
