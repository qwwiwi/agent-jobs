@@ -308,3 +308,33 @@ func TestEscapedCheckRefusesMissingLinuxProc(t *testing.T) {
 		t.Fatalf("missing /proc: %v", err)
 	}
 }
+
+const twoResultReport = "## Summary\\nok\\n\\n## Findings / Changes\\n-\\n\\n## Evidence\\n-\\n\\n## Not done / uncertain\\nnothing"
+
+func twoResultStream() string {
+	return `{"type":"result","subtype":"success","is_error":false,"num_turns":87,"total_cost_usd":2.5,"result":"` + twoResultReport + `"}` + "\n" +
+		`{"type":"result","subtype":"success","is_error":false,"num_turns":1,"total_cost_usd":2.6,"result":"This is a notification from my own wait timer"}` + "\n"
+}
+
+// A trailing result event from a background-task notification must not replace the report (#154).
+func TestParseStreamKeepsReportOverTrailingResult(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "stream.jsonl")
+	writeFile(t, p, []byte(twoResultStream()), 0o600)
+	r := ParseStream(p)
+	if !isReport(r.Text) || r.Turns != 88 || r.CostUSD != 2.6 || r.IsError || r.Subtype != "success" {
+		t.Fatalf("result: %+v", r)
+	}
+}
+
+// The tee (the wrapper's trusted view) merges the same way.
+func TestResultTeeKeepsReportOverTrailingResult(t *testing.T) {
+	var out bytes.Buffer
+	tee := &resultTee{w: &out}
+	if _, err := tee.Write([]byte(twoResultStream())); err != nil {
+		t.Fatal(err)
+	}
+	r := tee.res
+	if !isReport(r.Text) || r.Turns != 88 || r.CostUSD != 2.6 || r.Results != 2 {
+		t.Fatalf("result: %+v", r)
+	}
+}
