+// encodeReasons stores the depends_on reasons as a JSON object (” when there are none).
+func encodeReasons(r map[string]string) string {
+	if len(r) == 0 {
+		return ""
+	}
+	b, err := json.Marshal(r)
+	if err != nil {
+		return ""
+	}
+	return string(b)
+}
+
+// decodeReasons reads encodeReasons back; an unreadable value gives no reasons.
+func decodeReasons(s string) map[string]string {
+	if s == "" {
+		return nil
+	}
+	var r map[string]string
+	if err := json.Unmarshal([]byte(s), &r); err != nil {
+		return nil
+	}
+	return r
+}
