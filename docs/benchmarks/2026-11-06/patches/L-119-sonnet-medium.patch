+// #119: the daemon points at ready tasks while job slots are free.
+func TestIdleSlotLine(t *testing.T) {
+	m := newManager(t)
+	ctx := context.Background()
+	if line, err := m.IdleSlotLine(ctx); err != nil || line != "" {
+		t.Fatalf("no milestone: %q %v", line, err)
+	}
+	if _, err := m.CreateMilestone(ctx, MilestoneCreate{Title: "Train", Tasks: []MilestoneTaskInput{
+		{Key: "T8", Title: "a"}, {Key: "T9", Title: "b"},
+		{Key: "T10", Title: "c", DependsOn: deps("T8"), DependsReasons: map[string]string{"T8": "consumes T8 output"}},
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	line, err := m.IdleSlotLine(ctx)
+	want := formatIdleSlots(m.Config().MaxRunningJobs(), []string{"M1: T8, T9"})
+	if err != nil || line != want || !strings.Contains(line, "slots free, ready: M1: T8, T9") {
+		t.Fatalf("line %q want %q err %v", line, want, err)
+	}
+}
