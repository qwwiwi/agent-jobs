+// IdleSlotLine says, in one line, that job slots are free while tasks of open milestones are ready
+// (no job yet, dependencies done): "3 slots free, ready: M2: T8, T9". "" when no slot is free or no task
+// is ready. The orchestrator starts a job on each ready task; the daemon only points at them.
+func (m *Manager) IdleSlotLine(ctx context.Context) (string, error) {
+	running, err := m.Store.CountRunning()
+	if err != nil {
+		return "", err
+	}
+	queued, err := m.Store.ListByStatus(store.StatusQueued)
+	if err != nil {
+		return "", err
+	}
+	free := m.Config().MaxRunningJobs() - running - len(queued)
+	if free <= 0 {
+		return "", nil
+	}
+	list, err := m.Store.ListMilestones(ctx, store.MilestoneFilter{Status: store.MilestoneOpen})
+	if err != nil {
+		return "", err
+	}
+	var parts []string
+	for _, ms := range list {
+		v, err := m.MilestoneTree(ctx, ms.ID)
+		if err != nil {
+			return "", err
+		}
+		if len(v.Ready) > 0 {
+			parts = append(parts, fmt.Sprintf("M%d: %s", ms.ID, strings.Join(v.Ready, ", ")))
+		}
+	}
+	if len(parts) == 0 {
+		return "", nil
+	}
+	return formatIdleSlots(free, parts), nil
+}
+
+func formatIdleSlots(free int, parts []string) string {
+	noun := "slots"
+	if free == 1 {
+		noun = "slot"
+	}
+	return fmt.Sprintf("%d %s free, ready: %s", free, noun, strings.Join(parts, "; "))
+}
+
+// nudgeIdleSlots logs IdleSlotLine when it changes, so a heartbeat tick does not repeat itself.
+func (m *Manager) nudgeIdleSlots() error {
+	line, err := m.IdleSlotLine(context.Background())
+	if err != nil {
+		return err
+	}
+	m.nudgeMu.Lock()
+	defer m.nudgeMu.Unlock()
+	if line != "" && line != m.lastNudge {
+		m.Log.Printf("%s", line)
+	}
+	m.lastNudge = line
+	return nil
+}
