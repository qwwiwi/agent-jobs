+			{Key: "T1", Title: "a"},
+			{Key: "T2", Title: "b", DependsOn: deps("T1"), DependsReasons: map[string]string{"T1": "x\ny"}},
+		}})
+		if err == nil || !strings.Contains(err.Error(), "depends_reasons") {
+			t.Fatalf("err: %v", err)
+		}
+	})
+}
