@@ -0,0 +1,69 @@
+package jobs
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"testing"
+)
+
+// #119: every depends_on edge carries a reason; an edge without one is dropped so independent tasks
+// are all ready at once.
+func TestMilestoneEdgeReasons(t *testing.T) {
+	t.Run("edge without a reason is dropped and reported", func(t *testing.T) {
+		m := newManager(t)
+		v, err := m.CreateMilestone(context.Background(), MilestoneCreate{Title: "Train", Tasks: []MilestoneTaskInput{
+			{Key: "T1", Title: "orders"},
+			{Key: "T2", Title: "login", DependsOn: deps("T1")},
+			{Key: "T3", Title: "history", DependsOn: deps("T1"), DependsReasons: map[string]string{"T1": "both edit orders/store.go"}},
+		}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !slices.Equal(v.DroppedEdges, []string{"T2->T1"}) {
+			t.Fatalf("dropped edges: %v", v.DroppedEdges)
+		}
+		if len(taskOf(t, v, "T2").DependsOn) != 0 || !slices.Equal(v.Ready, []string{"T1", "T2"}) {
+			t.Fatalf("T2 should be independent: %+v ready %v", taskOf(t, v, "T2"), v.Ready)
+		}
+		t3 := taskOf(t, v, "T3")
+		if !slices.Equal(t3.DependsOn, []string{"T1"}) || t3.DependsReasons["T1"] != "both edit orders/store.go" || t3.Status != TaskBlocked {
+			t.Fatalf("T3: %+v", t3)
+		}
+		// The reason survives a reload and a later edit that repeats the edge without it.
+		v, err = m.SetMilestone(context.Background(), MilestoneSet{ID: v.ID, Tasks: []MilestoneTaskInput{{Key: "T3", DependsOn: deps("T1"), DependsReasons: why("T1")}}})
+		if err != nil || len(v.DroppedEdges) != 0 || taskOf(t, v, "T3").DependsReasons["T1"] == "" {
+			t.Fatalf("set: %v %+v", err, v)
+		}
+	})
+	t.Run("multi-line reason is refused", func(t *testing.T) {
+		m := newManager(t)
