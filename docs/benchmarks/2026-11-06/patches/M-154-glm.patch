+// A trailing `result` event from a background task's notification turn (#154): the report is the
+// last result text that has the report sections, turns and cost are the run total, and the last
+// event still says how the runner ended.
+func TestResultTeeTrailingNotification(t *testing.T) {
+	report := "## Summary\nok\n\n## Not done / uncertain\nnothing"
+	line := func(turns int, cost float64, text string) string {
+		b, err := json.Marshal(map[string]any{"type": "result", "subtype": "success", "is_error": false,
+			"num_turns": turns, "total_cost_usd": cost, "result": text})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return string(b) + "\n"
+	}
+	in := strings.Join([]string{
+		line(87, 1.5, report),
+		`{"type":"assistant","message":{"id":"n1","content":[{"type":"text","text":"notification text"}]}}` + "\n",
+		line(1, 0.25, "notification text"),
+	}, "")
+	tee := &resultTee{w: io.Discard}
+	if _, err := tee.Write([]byte(in)); err != nil {
+		t.Fatal(err)
+	}
+	tee.end()
+	r := tee.res
+	if !r.Found || r.Subtype != "success" || r.IsError || r.Results != 2 {
+		t.Fatalf("result: %+v", r)
+	}
+	if r.Turns != 88 || r.CostUSD != 1.75 {
+		t.Fatalf("turns/cost %d/%v, want the run total 88/1.75", r.Turns, r.CostUSD)
+	}
+	if r.Text != report {
+		t.Fatalf("text %q, want the report of the earlier result", r.Text)
+	}
+}
