+// A background task's notification wakes the session after its report (#154): the stream carries a
+// second `result` event whose text is the notification turn's short message. The report is the last
+// result text that has the report sections, turns and cost are the run total (both results summed),
+// and the job does not fail with NoteNoSummary over the trailing notification turn.
+func TestTrailingNotificationResultKeepsReport(t *testing.T) {
+	m := newManager(t)
+	noAutoContinue(m)
+	j := runToEnd(t, m, enqueue(t, m, "FAKE_BG_NOTIFY", nil).ID)
+	if j.Status != store.StatusSucceeded || j.Error != "" {
+		t.Fatalf("job: %s %q", j.Status, j.Error)
+	}
+	if j.Turns != 88 || j.CostUSD != 1.75 || j.CostUnknown {
+		t.Fatalf("turns/cost %d/%v unknown=%v, want the run total 88/1.75", j.Turns, j.CostUSD, j.CostUnknown)
+	}
+	report := "## Summary\nbg notify ok\n\n## Findings / Changes\n-\n\n## Evidence\n-\n\n## Not done / uncertain\nnothing\n\n## Progress\n- 10:00 UTC done\n"
+	if r := readFile(t, filepath.Join(m.JobDir(j.ID), "report.md")); r != report {
+		t.Fatalf("report.md not the first result's report: %q", r)
+	}
+}
