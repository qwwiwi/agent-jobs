diff --git a/internal/jobs/git_timeout_test.go b/internal/jobs/git_timeout_test.go
index 014ee40..88db3d1 100644
--- a/internal/jobs/git_timeout_test.go
+++ b/internal/jobs/git_timeout_test.go
@@ -329,3 +329,49 @@ exit 0
 		}
 	}
 }
+
+// A git cat-file that exits while a process of its group still holds the stdout pipe materializeTree
+// reads does not leave that process running past the deadline (#114): the manually read stream takes
+// part in the runner's completion protocol, so the group is killed while git still reserves its ID.
+func TestMaterializeTreeKillsChildHoldingStdout(t *testing.T) {
+	repo, sha := gateRepo(t)
+	real, err := exec.LookPath("git")
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := t.TempDir()
+	t.Setenv("FAKE_GIT_STATE", state)
+	fakeGitOnPath(t, `for a in "$@"; do
+  if [ "$a" = cat-file ]; then
+    sleep 60 &
+    echo $! > "$FAKE_GIT_STATE/child"
+    exit 0
+  fi
+done
+exec '`+real+`' "$@"
+`)
+	shortGitLongTimeout(t, time.Second)
+	origDelay := gitWaitDelay
+	gitWaitDelay = 30 * time.Second
+	t.Cleanup(func() { gitWaitDelay = origDelay })
+	err = returnsWithin(t, 10*time.Second, "materializeTree", func() error {
+		return materializeTree(repo, sha, t.TempDir(), nil)
+	})
+	b, rerr := os.ReadFile(filepath.Join(state, "child"))
+	if rerr != nil {
+		t.Fatal(rerr)
+	}
+	pid, rerr := strconv.Atoi(strings.TrimSpace(string(b)))
+	if rerr != nil {
+		t.Fatal(rerr)
+	}
+	defer func() { _ = syscall.Kill(pid, syscall.SIGKILL) }()
+	if !errors.Is(err, errGitTimeout) {
+		t.Fatalf("want errGitTimeout, got %v", err)
+	}
+	for deadline := time.Now().Add(5 * time.Second); !processGone(t, pid); time.Sleep(50 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			t.Fatalf("cat-file's child %d still runs after the deadline", pid)
+		}
+	}
+}
