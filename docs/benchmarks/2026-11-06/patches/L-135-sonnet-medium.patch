diff --git a/cmd/agent-jobs/uicheck.go b/cmd/agent-jobs/uicheck.go
new file mode 100644
index 0000000..5166db9
--- /dev/null
+++ b/cmd/agent-jobs/uicheck.go
@@ -0,0 +1,58 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+
+	agentjobs "github.com/qwwiwi/agent-jobs"
+)
+
+// runUICheck is `ui-check`: it writes the ui-check.mjs embedded in this binary to a private temp dir
+// and runs it with node and --trusted, so neither a job-dir copy of the tool nor a Playwright planted in
+// the current directory's node_modules (a job worktree) is ever executed. Arguments go to the script
+// unchanged (--playwright <path> names the trusted Playwright). Returns the script's exit code.
+func runUICheck(args []string, stdout, stderr io.Writer) int {
+	node, err := exec.LookPath("node")
+	if err != nil {
+		fmt.Fprintln(stdout, "BROWSER CHECK NOT RUN: node not found")
+		return 2
+	}
+	script, err := agentjobs.Templates.ReadFile("scripts/ui-check.mjs")
+	if err != nil {
+		fmt.Fprintln(stderr, "agent-jobs: ui-check:", err)
+		return 2
+	}
+	dir, err := os.MkdirTemp("", "agent-jobs-ui-check-") // mode 0700
+	if err != nil {
+		fmt.Fprintln(stderr, "agent-jobs: ui-check:", err)
+		return 2
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, "ui-check.mjs")
+	if err := os.WriteFile(path, script, 0o600); err != nil {
+		fmt.Fprintln(stderr, "agent-jobs: ui-check:", err)
+		return 2
+	}
+	cmd := exec.Command(node, append([]string{path, "--trusted"}, args...)...)
+	cmd.Stdout, cmd.Stderr = stdout, stderr
+	// NODE_OPTIONS and NODE_PATH can inject code or modules from the caller's environment.
+	env := os.Environ()[:0:0]
+	for _, kv := range os.Environ() {
+		if len(kv) >= 12 && kv[:12] == "NODE_OPTIONS" || len(kv) >= 9 && kv[:9] == "NODE_PATH" {
+			continue
+		}
+		env = append(env, kv)
+	}
+	cmd.Env = env
+	if err := cmd.Run(); err != nil {
+		if ee, ok := err.(*exec.ExitError); ok {
+			return ee.ExitCode()
+		}
+		fmt.Fprintln(stdout, "BROWSER CHECK NOT RUN: cannot start node:", err)
+		return 2
+	}
+	return 0
+}
diff --git a/cmd/agent-jobs/uicheck_test.go b/cmd/agent-jobs/uicheck_test.go
new file mode 100644
index 0000000..588af41
--- /dev/null
+++ b/cmd/agent-jobs/uicheck_test.go
@@ -0,0 +1,95 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// plantWorktree builds a job worktree with a planted tools/ui-check.mjs and a planted
+// node_modules/playwright; each one writes a marker file when it is executed.
+func plantWorktree(t *testing.T) (wt, marker string) {
+	t.Helper()
+	wt = t.TempDir()
+	marker = filepath.Join(t.TempDir(), "pwned")
+	payload := "require('fs').writeFileSync(" + "'" + marker + "', 'x');\n"
+	pw := filepath.Join(wt, "node_modules", "playwright")
+	must(t, os.MkdirAll(pw, 0o755))
+	must(t, os.WriteFile(filepath.Join(pw, "package.json"), []byte(`{"name":"playwright","main":"index.js"}`), 0o644))
+	must(t, os.WriteFile(filepath.Join(pw, "index.js"), []byte(payload+"module.exports={chromium:{launch(){throw new Error('planted')}}};\n"), 0o644))
+	must(t, os.MkdirAll(filepath.Join(wt, "tools"), 0o755))
+	must(t, os.WriteFile(filepath.Join(wt, "tools", "ui-check.mjs"), []byte(strings.Replace(payload, "require('fs')", "process.getBuiltinModule('fs')", 1)), 0o644))
+	return wt, marker
+}
+
+func must(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+// The trusted path runs the embedded script and never resolves Playwright from the cwd's node_modules.
+func TestUICheckIgnoresPlantedPlaywrightInCwd(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node not installed")
+	}
+	wt, marker := plantWorktree(t)
+	t.Chdir(wt)
+	t.Setenv("NODE_PATH", filepath.Join(wt, "node_modules"))
+	var out, errb bytes.Buffer
+	// No --playwright, so only the global root is consulted; the run must not execute the planted module.
+	runUICheck([]string{"http://127.0.0.1:1", "/", "--out", filepath.Join(t.TempDir(), "o")}, &out, &errb)
+	if _, err := os.Stat(marker); err == nil {
+		t.Fatalf("planted code was executed; output: %s%s", out.String(), errb.String())
+	}
+}
+
+// The job-dir copy of the tool is never what the trusted path runs.
+func TestUICheckDoesNotRunJobDirCopy(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node not installed")
+	}
+	wt, marker := plantWorktree(t)
+	t.Chdir(wt)
+	var out, errb bytes.Buffer
+	code := runUICheck([]string{"--help"}, &out, &errb)
+	if _, err := os.Stat(marker); err == nil {
+		t.Fatal("planted tools/ui-check.mjs was executed")
+	}
+	if code != 0 || !strings.Contains(out.String(), "usage: node ui-check.mjs") {
+		t.Fatalf("code %d, out %q, err %q: the embedded script did not run", code, out.String(), errb.String())
+	}
+}
+
+// --playwright names the trusted Playwright; it is used instead of any lookup.
+func TestUICheckPlaywrightFlag(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node not installed")
+	}
+	trusted := t.TempDir()
+	must(t, os.WriteFile(filepath.Join(trusted, "index.js"), []byte("module.exports={chromium:{launch(){throw new Error('trusted fake')}}};\n"), 0o644))
+	var out, errb bytes.Buffer
+	code := runUICheck([]string{"--playwright", filepath.Join(trusted, "index.js"), "http://127.0.0.1:1", "/", "--out", filepath.Join(t.TempDir(), "o")}, &out, &errb)
+	if code != 2 || !strings.Contains(out.String(), "trusted fake") {
+		t.Fatalf("code %d, out %q, err %q", code, out.String(), errb.String())
+	}
+}
+
+// The temp dir holding the extracted script is private and removed afterwards.
+func TestUICheckTempDirRemoved(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node not installed")
+	}
+	tmp := t.TempDir()
+	t.Setenv("TMPDIR", tmp)
+	var out, errb bytes.Buffer
+	runUICheck([]string{"--help"}, &out, &errb)
+	ents, _ := os.ReadDir(tmp)
+	if len(ents) != 0 {
+		t.Fatalf("temp dir left behind: %v", ents)
+	}
+}
