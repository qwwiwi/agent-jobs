+
+// A job queued before manifests existed keeps delivered skills with no manifest. Admission sees the
+// manifest, so the row loses it afterwards; the launch must still refuse it, edited or not.
+func TestResumeQueuedLegacySkillsLaunchRefused(t *testing.T) {
+	for _, edited := range []bool{false, true} {
+		name := "unchanged"
+		if edited {
+			name = "edited"
+		}
+		t.Run(name, func(t *testing.T) {
+			m, j, work := deliveredResumeSkills(t, false)
+			// Launch verifies the worktree record that job creation writes.
+			if err := m.markWorktree(j, work); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(m.JobDir(j.ID), "prompt.md"), []byte("original task\n"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if err := m.Store.Finish(j.ID, "skills-test", store.StatusFailed, 7, 0.4, 1, "turn limit", m.Now()); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := m.Resume(j.ID, "continue", Limits{}); err != nil {
+				t.Fatalf("manifested job refused at admission: %v", err)
+			}
+			if got := get(t, m, j.ID); got.Status != store.StatusQueued {
+				t.Fatalf("admitted resume must be queued: status=%s", got.Status)
+			}
+			if err := m.Store.Claim(j.ID, "resume-test", m.Now()); err != nil {
+				t.Fatal(err)
+			}
+			if err := m.Store.SetSkillsDelivered(j.ID, "resume-test", j.SkillsDelivered, j.SkillsNote); err != nil {
+				t.Fatal(err)
+			}
+			if edited {
+				if err := os.WriteFile(filepath.Join(work, ".claude", "skills", "golang", "SKILL.md"), []byte("changed instructions\n"), 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			const reason = "no verifiable baseline"
+			if _, err := m.prepareResume(get(t, m, j.ID), "resume-test"); err == nil || !strings.Contains(err.Error(), reason) {
+				t.Fatalf("queued legacy delivery launch must refuse with %q: %v", reason, err)
+			}
+		})
+	}
+}
