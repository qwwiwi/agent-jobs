diff --git a/cmd/agent-jobs/ui_check_cmd_test.go b/cmd/agent-jobs/ui_check_cmd_test.go
new file mode 100644
index 0000000..fcf7de1
--- /dev/null
+++ b/cmd/agent-jobs/ui_check_cmd_test.go
@@ -0,0 +1,189 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	agentjobs "github.com/qwwiwi/agent-jobs"
+)
+
+// A fake node on PATH: records the exact command line (script path first, then the forwarded args),
+// a copy of the script it was told to run and its environment, then exits with a distinctive code.
+func fakeNode(t *testing.T, record string) string {
+	t.Helper()
+	bin := filepath.Join(t.TempDir(), "node")
+	script := "#!/bin/sh\n" +
+		"printf '%s\\n' \"$@\" > \"" + record + "/argv\"\n" +
+		"cp \"$1\" \"" + record + "/script.mjs\"\n" +
+		"env > \"" + record + "/env\"\n" +
+		"exit 7\n"
+	if err := os.WriteFile(bin, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return bin
+}
+
+// `agent-jobs ui-check` runs the scripts/ui-check.mjs copy embedded in the binary, from a private temp
+// dir — never the tools/ui-check.mjs copy a job dir holds (#135: the job can replace it). Every
+// argument (--playwright included) is forwarded, AGENT_JOBS_UI_CHECK is forced to 1 (a stale value
+// must not decide the script's mode) and the child's exit code passes through; the temp dir is gone
+// afterwards.
+func TestUICheckRunsEmbeddedCopyNotJobDirFile(t *testing.T) {
+	record := t.TempDir()
+	bin := filepath.Dir(fakeNode(t, record))
+	t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+	// A stale marker must not survive into the child.
+	t.Setenv("AGENT_JOBS_UI_CHECK", "0")
+
+	// The planted copy a job could leave in its dir; running it would be job-controlled code.
+	planted := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(planted, "tools"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	toolFile := filepath.Join(planted, "tools", "ui-check.mjs")
+	if err := os.WriteFile(toolFile, []byte("planted by a job\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	var out, errb bytes.Buffer
+	args := []string{"http://127.0.0.1:8000", "/", "/blog/post", "--out", "shots", "--playwright", "/opt/playwright"}
+	if code := runUICheck(args, &out, &errb); code != 7 {
+		t.Fatalf("exit code = %d, want 7 (the child's own code passes through); out=%q err=%q", code, out.String(), errb.String())
+	}
+	argvB, err := os.ReadFile(filepath.Join(record, "argv"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	argv := strings.Split(strings.TrimRight(string(argvB), "\n"), "\n")
+	if len(argv) != 1+len(args) {
+		t.Fatalf("node argv = %q, want the script plus %d forwarded args", argv, len(args))
+	}
+	scriptPath := argv[0]
+	if filepath.Base(scriptPath) != "ui-check.mjs" {
+		t.Fatalf("node runs %q, want a ui-check.mjs script path", scriptPath)
+	}
+	if strings.HasPrefix(scriptPath, planted) {
+		t.Fatalf("node runs the job-dir copy %q", scriptPath)
+	}
+	for i, want := range args {
+		if argv[1+i] != want {
+			t.Errorf("forwarded arg %d = %q, want %q", i, argv[1+i], want)
+		}
+	}
+	// The script node runs is the embedded copy, byte for byte.
+	got, err := os.ReadFile(filepath.Join(record, "script.mjs"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	emb, err := agentjobs.Templates.ReadFile("scripts/ui-check.mjs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, emb) {
+		t.Error("the script node runs differs from the embedded scripts/ui-check.mjs")
+	}
+	// The planted copy is untouched.
+	if b, _ := os.ReadFile(toolFile); string(b) != "planted by a job\n" {
+		t.Errorf("planted tools/ui-check.mjs was rewritten: %q", b)
+	}
+	// The child runs in trusted mode, exactly once.
+	envB, err := os.ReadFile(filepath.Join(record, "env"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	marks := 0
+	for _, line := range strings.Split(string(envB), "\n") {
+		if line == "AGENT_JOBS_UI_CHECK=1" {
+			marks++
+		} else if strings.HasPrefix(line, "AGENT_JOBS_UI_CHECK=") {
+			t.Errorf("child env has a stale marker: %q", line)
+		}
+	}
+	if marks != 1 {
+		t.Errorf("child env has %d AGENT_JOBS_UI_CHECK=1 entries, want 1", marks)
+	}
+	// The private temp dir is removed after the run.
+	if _, err := os.Stat(scriptPath); !os.IsNotExist(err) {
+		t.Errorf("temp script %q still exists after the run (stat err %v)", scriptPath, err)
+	}
+}
+
+// The trusted path with a real node: a planted tools/ui-check.mjs and a planted
+// node_modules/playwright in the worktree the orchestrator runs from are not executed (#135). The
+// run cannot find Playwright (cwd lookup skipped, NODE_PATH empty, a fake npm names a nonexistent
+// global root) and reports BROWSER CHECK NOT RUN instead. Skipped when node is not installed.
+func TestUICheckTrustedRunSkipsWorktreeCode(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node not installed")
+	}
+	// A fake npm ahead of the real one: its "global root" does not exist, so nothing but the
+	// worktree could provide Playwright.
+	fakeBin := t.TempDir()
+	globalRoot := filepath.Join(t.TempDir(), "no-such-global-root")
+	if err := os.WriteFile(filepath.Join(fakeBin, "npm"), []byte("#!/bin/sh\necho \""+globalRoot+"\"\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", fakeBin+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("NODE_PATH", "")
+	t.Setenv("AGENT_JOBS_UI_CHECK", "0")
+
+	marks := t.TempDir()
+	toolMark := filepath.Join(marks, "tool-ran")
+	pwMark := filepath.Join(marks, "playwright-ran")
+	t.Setenv("UI_CHECK_TOOL_MARKER", toolMark)
+	t.Setenv("UI_CHECK_PLAYWRIGHT_MARKER", pwMark)
+
+	// The worktree: a planted tool copy and a planted playwright package, both of which would leave
+	// a marker file if they ran.
+	worktree := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(worktree, "tools"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	toolFile := filepath.Join(worktree, "tools", "ui-check.mjs")
+	if err := os.WriteFile(toolFile, []byte("require('fs').writeFileSync(process.env.UI_CHECK_TOOL_MARKER, 'ran');\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	pwDir := filepath.Join(worktree, "node_modules", "playwright")
+	if err := os.MkdirAll(pwDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(pwDir, "package.json"), []byte(`{"name":"playwright","main":"index.js"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(pwDir, "index.js"),
+		[]byte("require('fs').writeFileSync(process.env.UI_CHECK_PLAYWRIGHT_MARKER, 'ran');\nmodule.exports = {};\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// The orchestrator runs from inside the worktree (it checks the diff there).
+	t.Chdir(worktree)
+
+	var out, errb bytes.Buffer
+	code := runUICheck([]string{"http://127.0.0.1:1", "/"}, &out, &errb)
+	if code != 2 {
+		t.Fatalf("exit code = %d, want 2 (not run); out=%q err=%q", code, out.String(), errb.String())
+	}
+	if !strings.Contains(out.String(), "BROWSER CHECK NOT RUN: Playwright not found") {
+		t.Errorf("stdout = %q, want the Playwright-not-found line", out.String())
+	}
+	for name, mark := range map[string]string{"tools/ui-check.mjs": toolMark, "node_modules/playwright": pwMark} {
+		if _, err := os.Stat(mark); !os.IsNotExist(err) {
+			t.Errorf("the planted %s ran with the orchestrator's privileges (marker %s exists, stat err %v)", name, mark, err)
+		}
+	}
+}
+
+// Without node the command still speaks the report contract's line and exits 2.
+func TestUICheckNodeMissing(t *testing.T) {
+	t.Setenv("PATH", t.TempDir())
+	var out, errb bytes.Buffer
+	if code := runUICheck([]string{"http://127.0.0.1:8000", "/"}, &out, &errb); code != 2 {
+		t.Fatalf("exit code = %d, want 2", code)
+	}
+	if !strings.Contains(out.String(), "BROWSER CHECK NOT RUN: node not installed") {
+		t.Errorf("stdout = %q, want the node-not-installed line", out.String())
+	}
+}
diff --git a/cmd/agent-jobs/uicheck.go b/cmd/agent-jobs/uicheck.go
new file mode 100644
index 0000000..1418f2c
--- /dev/null
+++ b/cmd/agent-jobs/uicheck.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	agentjobs "github.com/qwwiwi/agent-jobs"
+)
+
+// runUICheck is the orchestrator's browser check (#135): it runs the scripts/ui-check.mjs copy embedded
+// in this binary, written to a private temp dir (0700, removed afterwards), never a file from a job dir
+// or worktree — a job can replace <job dir>/tools/ui-check.mjs, and that would run with the
+// orchestrator's privileges. The child runs with AGENT_JOBS_UI_CHECK=1, the script's trusted mode:
+// Playwright is resolved from NODE_PATH, the global npm root or an explicit --playwright <path>, never
+// from the current directory's node_modules. Arguments (base-url, paths and every script flag,
+// --playwright included) and the exit code (0 pass, 1 fail, 2 not run) pass through unchanged.
+func runUICheck(args []string, stdout, stderr io.Writer) int {
+	node, err := exec.LookPath("node")
+	if err != nil {
+		fmt.Fprintln(stdout, "BROWSER CHECK NOT RUN: node not installed")
+		return 2
+	}
+	b, err := agentjobs.Templates.ReadFile("scripts/ui-check.mjs")
+	if err != nil {
+		fmt.Fprintf(stderr, "agent-jobs: ui-check: embedded script: %v\n", err)
+		return 2
+	}
+	dir, err := os.MkdirTemp("", "agent-jobs-ui-check-")
+	if err != nil {
+		fmt.Fprintf(stderr, "agent-jobs: ui-check: temp dir: %v\n", err)
+		return 2
+	}
+	defer os.RemoveAll(dir)
+	script := filepath.Join(dir, "ui-check.mjs")
+	// Read-only: the child only loads it; nothing else may write it while it runs.
+	if err := os.WriteFile(script, b, 0o400); err != nil {
+		fmt.Fprintf(stderr, "agent-jobs: ui-check: write script: %v\n", err)
+		return 2
+	}
+	cmd := exec.Command(node, append([]string{script}, args...)...)
+	cmd.Env = trustedUICheckEnv(os.Environ())
+	cmd.Stdout, cmd.Stderr = stdout, stderr
+	if err := cmd.Run(); err != nil {
+		var ee *exec.ExitError
+		if errors.As(err, &ee) && ee.ExitCode() >= 0 {
+			return ee.ExitCode() // 0/1/2 of the script, or a node crash code as-is
+		}
+		fmt.Fprintf(stderr, "agent-jobs: ui-check: %v\n", err)
+		return 2
+	}
+	return 0
+}
+
+// trustedUICheckEnv replaces any AGENT_JOBS_UI_CHECK from the environment (a stale or injected value
+// must not decide the script's mode) with 1.
+func trustedUICheckEnv(environ []string) []string {
+	out := make([]string, 0, len(environ)+1)
+	for _, kv := range environ {
+		if strings.HasPrefix(kv, "AGENT_JOBS_UI_CHECK=") {
+			continue
+		}
+		out = append(out, kv)
+	}
+	return append(out, "AGENT_JOBS_UI_CHECK=1")
+}
