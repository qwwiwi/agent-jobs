+
+// A cat-file that exits at once while a descendant still holds the stdout pipe materializeTree reads does
+// not leave that descendant running past the deadline (#114): the stdout the call reads takes part in the
+// runner's completion protocol, so that git stays unreaped, and its group killable, until the pipe is
+// done or the group is killed.
+func TestMaterializeTreeKillsDescendantAfterCatFileExit(t *testing.T) {
+	repo, sha := gateRepo(t)
+	real, err := exec.LookPath("git")
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := t.TempDir()
+	if strings.ContainsRune(state, '\'') {
+		t.Fatalf("state directory %q has a quote", state)
+	}
+	fakeGitOnPath(t, `for a in "$@"; do
+  if [ "$a" = cat-file ]; then
+    sleep 60 &
+    echo $! > '`+state+`/child'
+    exit 0
+  fi
+done
+exec '`+real+`' "$@"
+`)
+	// A deadline wide enough for the fake to record the child's pid on a busy host, and a wait delay past
+	// it, so that the kill comes from the deadline.
+	shortGitLongTimeout(t, time.Second)
+	origDelay := gitWaitDelay
+	gitWaitDelay = 30 * time.Second
+	t.Cleanup(func() { gitWaitDelay = origDelay })
+	err = returnsWithin(t, 10*time.Second, "materializeTree", func() error {
+		return materializeTree(repo, sha, t.TempDir(), nil)
+	})
+	b, rerr := os.ReadFile(filepath.Join(state, "child"))
+	if rerr != nil {
+		t.Fatal(rerr)
+	}
+	pid, perr := strconv.Atoi(strings.TrimSpace(string(b)))
+	if perr != nil {
+		t.Fatal(perr)
+	}
+	defer func() { _ = syscall.Kill(pid, syscall.SIGKILL) }()
+	if !errors.Is(err, errGitTimeout) {
+		t.Fatalf("want errGitTimeout, got %v", err)
+	}
+	for deadline := time.Now().Add(5 * time.Second); !processGone(t, pid); time.Sleep(50 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			t.Fatalf("cat-file's descendant %d still runs after the deadline: the group was not killed", pid)
+		}
+	}
+}
