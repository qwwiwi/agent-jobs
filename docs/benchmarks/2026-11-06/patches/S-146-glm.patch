@@ -436,6 +436,55 @@ func (o *OpenRouterConfig) deniedRepo(repo string) string {
 	return ""
 }
 
+// checkOpenRouterSources refuses sources that would carry a denied repository's content to the
+// provider (#146): deny_repos binds the job's own repository only, so without this check a file from
+// a denied repository (or another job's report about one) could be attached to an OpenRouter job and
+// so reach a third-party provider. A file source is denied when a directory that contains it is a
+// denied repository; a job:<id> source when the job it names ran on one. repoOf maps a source job's
+// id to its repository path; one whose row cannot be read is refused, for its report may be about a
+// denied repository.
+func (o *OpenRouterConfig) checkOpenRouterSources(origins []string, repoOf func(id string) (string, error)) error {
+	if o == nil || len(origins) == 0 {
+		return nil
+	}
+	for _, origin := range origins {
+		if id, ok := strings.CutPrefix(origin, "job:"); ok {
+			repo, err := repoOf(id)
+			if err != nil {
+				return fmt.Errorf("sources %q: the job's repository could not be read: %w", origin, err)
+			}
+			if repo != "" {
+				if d := o.deniedRepo(repo); d != "" {
+					return fmt.Errorf("sources %q: job %s ran on repository %s, denied to openrouter jobs "+
+						"(providers.openrouter.deny_repos %q)", origin, id, repo, d)
+				}
+			}
+			continue
+		}
+		if d, dir := o.deniedContainingRepo(origin); d != "" {
+			return fmt.Errorf("sources %q: the file is inside %s, denied to openrouter jobs "+
+				"(providers.openrouter.deny_repos %q)", origin, dir, d)
+		}
+	}
+	return nil
+}
+
+// deniedContainingRepo returns the deny_repos entry that matches a directory containing path, with
+// that directory ("" for none): the file is inside a denied repository. Every parent directory of the
+// file is matched the way a job's repository is (deniedRepo): an absolute entry or glob matches the
+// repository path, a name entry its folder name, so <repo>/notes.md is denied by the repository's
+// name and by an absolute glob of its path alike.
+func (o *OpenRouterConfig) deniedContainingRepo(path string) (entry, dir string) {
+	for dir = filepath.Dir(filepath.Clean(path)); ; dir = filepath.Dir(dir) {
+		if entry = o.deniedRepo(dir); entry != "" {
+			return entry, dir
+		}
+		if parent := filepath.Dir(dir); parent == dir {
+			return "", ""
+		}
+	}
+}
