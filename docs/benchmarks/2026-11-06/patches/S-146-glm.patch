+		return err
+	}
+	for name, deny := range map[string][]string{
+		"folder name": {filepath.Base(repo)},
+		"absolute":    {repo},
+		"glob":        {filepath.Base(repo) + "*"},
+	} {
+		m.Cfg.Providers.OpenRouter.DenyRepos = deny
