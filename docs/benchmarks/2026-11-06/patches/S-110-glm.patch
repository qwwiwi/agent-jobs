+// The child mode of this test binary for TestFailedPidWaitNeverLeaksHelper (#110): the gate, and
+// the file the child publishes its helper's pid to before its pid wait fails.
+const (
+	pidWaitFailEnv    = "AGENT_JOBS_TEST_PIDWAIT_FAIL"
+	pidWaitFailPidEnv = "AGENT_JOBS_TEST_PIDWAIT_FAIL_PID"
+)
+
+// TestPidWaitFailHelper runs only as the child of TestFailedPidWaitNeverLeaksHelper: it starts the
+// stall helper (it hangs before writing its pid file), publishes the helper's pid for the parent,
+// then dies of the failed pid wait -- the exact t.Fatalf-inside-waitFor path that used to run no
+// cleanup for the helper (#110).
+func TestPidWaitFailHelper(t *testing.T) {
+	pidFile := os.Getenv(ownedHelperPIDFile)
+	if os.Getenv(pidWaitFailEnv) == "" || pidFile == "" {
+		t.Skip("helper of TestFailedPidWaitNeverLeaksHelper")
+	}
+	c := exec.Command(os.Args[0], "-test.run=^TestOwnedHelperDaemon$", "-test.count=1")
+	c.Env = append(os.Environ(), ownedHelperEnv+"="+selfBin, ownedHelperPIDFile+"="+pidFile, ownedHelperMode+"=stall")
+	c.Stdout, c.Stderr = io.Discard, io.Discard
+	_ = startHelperOwned(t, c)
+	if err := os.WriteFile(os.Getenv(pidWaitFailPidEnv), []byte(strconv.Itoa(c.Process.Pid)+"\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// The wait that fails: the stall helper writes the pid file only after its two-minute sleep,
+	// so waitFor ends in its t.Fatalf long before that.
+	waitFor(t, "daemon pid", 2*time.Second, func() bool {
+		_, err := os.ReadFile(pidFile)
+		return err == nil
+	})
+}
+
+// #110: a pid-file wait that fails (the t.Fatalf inside waitFor) before the test's own kill must not
+// leave the helper running to the end of its two-minute sleep. The child test above walks that exact
+// path; this test checks the child failed its wait and that its helper is gone once it did.
+func TestFailedPidWaitNeverLeaksHelper(t *testing.T) {
+	dir := t.TempDir()
+	pidFile := filepath.Join(dir, "daemon.pid")
+	helperPidFile := filepath.Join(dir, "helper.pid")
+	c := exec.Command(os.Args[0], "-test.run=^TestPidWaitFailHelper$", "-test.count=1")
+	c.Env = append(os.Environ(), ownedHelperEnv+"="+selfBin, ownedHelperPIDFile+"="+pidFile, pidWaitFailEnv+"=1", pidWaitFailPidEnv+"="+helperPidFile)
+	c.Stdout, c.Stderr = io.Discard, io.Discard
+	done := startHelperOwned(t, c)
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("the pid-wait helper passed; it must fail its wait")
+		}
+	case <-time.After(30 * time.Second):
+		_ = c.Process.Kill()
+		t.Fatal("pid-wait helper did not end")
+	}
+	b, err := os.ReadFile(helperPidFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	helper, err := strconv.Atoi(strings.TrimSpace(string(b)))
+	if err != nil || helper <= 0 {
+		t.Fatalf("bad helper pid %q", b)
+	}
+	if alive(helper) {
+		t.Fatalf("the failed pid wait leaked its helper (pid %d)", helper)
+	}
+}
