+// startHelperOwned starts the helper test process c and returns the channel of its end (c.Wait's
+// error, buffered). The cleanup that kills and joins it is registered right after the start, before
+// any wait, so no path out of the test -- a pid-file wait that fails before the test's own kill
+// included -- leaves the helper running to the end of its two-minute sleep (#110). c.Wait itself
+// runs only in the goroutine that feeds done; the cleanup kills and then waits for that goroutine,
+// on every path and at most once.
+func startHelperOwned(t *testing.T, c *exec.Cmd) <-chan error {
+	t.Helper()
+	if err := c.Start(); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	exited := make(chan struct{})
+	go func() {
+		defer close(exited)
+		done <- c.Wait()
+	}()
+	t.Cleanup(func() {
+		_ = c.Process.Kill()
+		select {
+		case <-exited:
+		case <-time.After(30 * time.Second):
+			t.Errorf("helper pid %d did not end after SIGKILL", c.Process.Pid)
+		}
+	})
+	return done
+}
