@@ -0,0 +1,51 @@
+package guard
+
+import "testing"
+
+// Issue #155: the remaining remote-rsync bypasses after #116, and two false positives.
+func TestRsyncBypassesIssue155(t *testing.T) {
+	t.Setenv("HOME", "/home/u")
+	t.Setenv("CDPATH", "")
+	cfg := Config{Dir: "/home/u/work"}
+	cases := []struct {
+		name  string
+		cmd   string
+		block bool
+	}{
+		// High: a literal `+` inside rsync's argv is not find's terminator.
+		{"find -exec literal plus", `find . -maxdepth 0 -exec rsync --exclude + ./src/ host:/dst/ \;`, true},
+		{"find -exec {} plus terminator", `find . -exec rsync a host:/b {} +`, true},
+		{"find -exec local then plus action", `find . -exec rsync a b \; -printf '%p:%y\n'`, false},
+		// High: inline interpreter code mentioning rsync.
+		{"python -c os.system rsync", `python3 -c 'import os; os.system("rsync ./src/ host:/dst/")'`, true},
+		{"node -e rsync", `node -e 'require("child_process").execSync("rsync a h:/b")'`, true},
+		{"watch string rsync", `watch 'rsync a host:/b'`, true},
+		{"python -c without rsync", `python3 -c 'print(1)'`, false},
+		// High: a dynamic operand cannot be verified.
+		{"setsid rsync var operand", `DST=host:/dst/; setsid rsync ./src/ "$DST"`, true},
+		{"direct rsync var operand", `DST=host:/dst/; rsync ./src/ "$DST"`, true},
+		{"nohup rsync substitution", `nohup rsync ./src/ "$(cat d)"`, true},
+		{"find -exec rsync var operand", `find . -maxdepth 0 -exec rsync ./src/ "$D" \;`, true},
+		{"rsync var with local prefix", `rsync -a ./src/ ./dst/"$N"`, false},
+		{"rsync var with remote prefix", `rsync -a ./src/ host:"$N"`, true},
+		// Double nesting: the remote operand comes from parallel's input.
+		{"find -exec parallel rsync", `find . -exec parallel rsync ./src/ \;`, true},
+		{"find -exec parallel ssh", `find . -exec parallel ssh \;`, true},
+		// Medium: option values are data.
+		{"log-file-format value", `rsync --log-file-format '%f:%l' ./src/ ./dst/`, false},
+		{"-f filter with glob", `rsync -f'- *.cache' ./src/ ./dst/`, false},
+		{"-f separate filter with glob", `rsync -f '- *.cache' ./src/ ./dst/`, false},
+		{"--exclude glob value", `rsync --exclude='*.log' ./src/ ./dst/`, false},
+		{"--filter glob value", `rsync --filter '- *.o' ./src/ ./dst/`, false},
+		{"glob operand still refused", `rsync ./src/* ./dst/`, true},
+		{"filter naming git config", `rsync -f'+ .git/config' ./src/ ./.git/config`, true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := Check(c.cmd, cfg)
+			if (got != "") != c.block {
+				t.Fatalf("Check(%q) = %q, want block=%v", c.cmd, got, c.block)
+			}
+		})
+	}
+}
